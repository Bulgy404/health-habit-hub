# Visual Studio Code files
.vscode/

# Node.js files
node_modules/
.npm/
build/
admin/.next/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Yarn package manager files
yarn.lock

# MacOS specific files
.DS_Store

# Environment variables
.env*
!.env.example

# Backup files — everything here is runtime-generated (tarballs, manifests,
# raw mongo dump dirs, job state); keep the directory in git via .gitkeep only.
backups/*
!backups/.gitkeep
analytics/*.tar.gz

# Test coverage output
app/coverage/

# Claude Files
.claude

# Mongo Data
/mongo/data/

# Generated and IDE files
*.log
dist/
tmp/
.cache/
.idea/
*.swp
*.swo
*~
Thumbs.db
*.tsbuildinfo

# Claude planning artifacts
docs/superpowers/

# Archive backups
*.tar.gz

# rclone offsite-backup credentials
backup-service/rclone/

# Personal working notes/paper drafts — not meant for the public repo.
paper/

# LightRAG knowledge corpus — source documents are NEVER committed.
# The corpus may contain third-party, copyright-protected literature that we
# are not licensed to redistribute, and this repository is public. Provide the
# documents at deploy time instead (see lightrag/knowledge/README.md and the
# LIGHTRAG_KNOWLEDGE_DIR bind mount in docker-compose.yml).
lightrag/knowledge/*
!lightrag/knowledge/.gitkeep
!lightrag/knowledge/README.md
