---
import { useT, routes, links, type Lang } from '../i18n/ui';
import GrowthGraph from './GrowthGraph.astro';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang); const R = routes;
const titleHtml = t('home_title').replace(t('home_title_em'), `<em>${t('home_title_em')}</em>`);
---
<header class="hero">
  <div class="hero-bg"></div>
  <div class="wrap hero-grid">
    <div>
      <h1 class="title reveal" set:html={titleHtml}></h1>
      <p class="lead reveal">{t('home_lead')}</p>
      <div class="hero-cta reveal">
        <a class="btn btn-primary btn-lg" href={R.participants[lang]}>{t('home_cta_part')}</a>
        <a class="btn btn-ghost btn-lg" href={R.research[lang]}>{t('home_cta_res')}</a>
      </div>
      <div class="hero-meta reveal">
        <div class="m"><div class="n">iOS · Android · Web</div><div class="l">{t('meta_devices')}</div></div>
        <div class="m"><div class="n">DSGVO</div><div class="l">{t('meta_gdpr')}</div></div>
      </div>
    </div>
    <GrowthGraph lang={lang} />
  </div>
</header>

<section>
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">{t('what_eyebrow')}</span>
      <h2 class="sec-title">{t('what_title')}</h2>
      <p class="sec-sub">{t('what_sub')}</p>
    </div>
    <div class="cards">
      <div class="card reveal"><div class="k"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M9 11l3 3 8-8"/><path d="M21 12v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h11"/></svg></div><h3>{t('c1t')}</h3><p>{t('c1p')}</p></div>
      <div class="card reveal"><div class="k"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></div><h3>{t('c2t')}</h3><p>{t('c2p')}</p></div>
      <div class="card reveal"><div class="k"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h3>{t('c3t')}</h3><p>{t('c3p')}</p></div>
    </div>
  </div>
</section>

<section class="fork">
  <div class="wrap">
    <div class="fork-head reveal">
      <span class="eyebrow">{t('fork_eyebrow')}</span>
      <h2>{t('fork_title')}</h2>
      <p class="sub">{t('fork_sub')}</p>
    </div>
    <div class="paths">
      <a class="path reveal" href={R.participants[lang]}>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></div>
        <div class="role-q">{t('fork_p_q')}</div><h3>{t('fork_p_t')}</h3><p>{t('fork_p_p')}</p>
        <span class="go">{t('fork_p_go')} <span class="arr">→</span></span>
      </a>
      <a class="path reveal" href={R.research[lang]}>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.7"><path d="M9 3v6l-5 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-9V3"/><path d="M8 3h8"/></svg></div>
        <div class="role-q">{t('fork_r_q')}</div><h3>{t('fork_r_t')}</h3><p>{t('fork_r_p')}</p>
        <span class="go">{t('fork_r_go')} <span class="arr">→</span></span>
      </a>
    </div>
  </div>
</section>

<section class="trust">
  <div class="wrap">
    <div class="t-txt reveal">
      <span class="eyebrow">{t('trust_eyebrow')}</span>
      <h3>{t('trust_title')}</h3>
      <p>{t('trust_p')}</p>
    </div>
    <div class="reveal"><a class="btn btn-primary btn-lg" href={links.admin}>{t('trust_btn')} →</a></div>
  </div>
</section>

<style>
  .hero{position:relative;overflow:hidden;padding:76px 0 84px}
  .hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(720px 400px at 82% -10%,rgba(78,198,0,.13),transparent 60%),radial-gradient(560px 380px at -4% 112%,rgba(37,111,0,.07),transparent 55%)}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
  .title{font-size:clamp(40px,5.6vw,66px);max-width:14ch}
  .title :global(em){font-style:normal;color:var(--green-dark)}
  .lead{font-size:clamp(17px,2vw,20px);color:var(--muted);max-width:46ch;margin:24px 0 34px}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap}
  .hero-meta{display:flex;gap:30px;margin-top:46px;flex-wrap:wrap}
  .hero-meta .m{border-left:2px solid var(--green);padding-left:14px}
  .hero-meta .n{font-family:'Fraunces Variable',serif;font-size:23px;color:var(--ink);font-weight:600}
  .hero-meta .l{font-size:13px;color:var(--muted)}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:28px;transition:transform .2s var(--ease),box-shadow .2s,border-color .2s}
  .card:hover{border-color:#cbd5e1;box-shadow:0 12px 32px rgba(15,23,42,.07);transform:translateY(-3px)}
  .card .k{width:42px;height:42px;border-radius:11px;background:var(--green-tint);display:grid;place-items:center;margin-bottom:16px}
  .card .k svg{width:22px;height:22px;stroke:var(--green-action)}
  .card h3{font-size:19px}
  .card p{color:var(--muted);font-size:14.5px;margin-top:9px}
  .fork{background:var(--slate);color:#e2e8f0}
  .fork-head{text-align:center;max-width:60ch;margin:0 auto 48px}
  .fork .eyebrow{color:var(--green-soft)}
  .fork h2{color:#fff;font-size:clamp(30px,4vw,44px);margin-top:12px}
  .fork .sub{color:#94a3b8;margin-top:14px;font-size:17px}
  .paths{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .path{position:relative;background:#243044;border:1px solid #334155;border-radius:20px;padding:38px 34px;overflow:hidden;transition:transform .25s var(--ease),box-shadow .25s,border-color .25s;cursor:pointer;display:block}
  .path::before{content:"";position:absolute;inset:0;background:radial-gradient(440px 220px at 100% 0,rgba(78,198,0,.15),transparent 60%);opacity:0;transition:opacity .3s}
  .path:hover{transform:translateY(-5px);border-color:var(--green);box-shadow:0 26px 50px rgba(0,0,0,.36)}
  .path:active{transform:translateY(-2px) scale(.995)}
  .path:hover::before{opacity:1}
  .path .ic{width:52px;height:52px;border-radius:14px;background:rgba(69,183,0,.14);border:1px solid rgba(78,198,0,.3);display:grid;place-items:center;margin-bottom:22px}
  .path .ic svg{width:26px;height:26px;stroke:var(--green-soft)}
  .path h3{color:#fff;font-size:25px}
  .path .role-q{font-size:13px;color:var(--green-soft);font-weight:600;margin-bottom:6px}
  .path p{color:#94a3b8;font-size:15px;margin:12px 0 22px}
  .path .go{display:inline-flex;align-items:center;gap:8px;color:#fff;font-weight:600;font-size:14.5px}
  .path .go .arr{transition:transform .2s var(--ease)}
  .path:hover .go .arr{transform:translateX(5px)}
  .trust{background:var(--green-tint);border-top:1px solid #dcfce7;border-bottom:1px solid #dcfce7}
  .trust .wrap{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap}
  .trust .t-txt{max-width:52ch}
  .trust h3{font-size:24px}
  .trust p{color:var(--muted);margin-top:8px;font-size:15px}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:40px}.paths,.cards{grid-template-columns:1fr}}
  @media (prefers-reduced-motion: reduce){.path:hover,.card:hover{transform:none}}
</style>
