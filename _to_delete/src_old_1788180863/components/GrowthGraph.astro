---
import { useT, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<div class="graph-card reveal">
  <div class="graph-head">
    <div><div class="gt">{t('chart_title')}</div><div class="gs">{t('chart_sub')}</div></div>
    <span class="graph-badge"><span class="up"></span> {t('chart_badge')}</span>
  </div>
  <svg class="chart" data-growth viewBox="0 0 460 210" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#45b700" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#45b700" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <line class="grid-line" x1="0" y1="40" x2="460" y2="40"/>
    <line class="grid-line" x1="0" y1="90" x2="460" y2="90"/>
    <line class="grid-line" x1="0" y1="140" x2="460" y2="140"/>
    <line class="grid-line" x1="0" y1="190" x2="460" y2="190"/>
    <path class="area" data-area d=""/>
    <path class="line" data-line d=""/>
    <circle class="pulse" data-pulse r="0"/>
    <circle class="dot dot-live" data-live r="0"/>
  </svg>
  <div class="xlabels"><span>{t('w1')}</span><span>{t('w2')}</span><span>{t('w3')}</span></div>
  <div class="chart-note">{t('chart_note')}</div>
</div>

<style>
  .graph-card{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:26px 26px 18px;box-shadow:0 30px 60px -24px rgba(15,23,42,.22)}
  .graph-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;gap:12px}
  .graph-head .gt{font-weight:600;font-size:14.5px}
  .graph-head .gs{font-size:12.5px;color:var(--muted)}
  .graph-badge{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--green-dark);background:var(--green-tint);border:1px solid #bbf7d0;padding:5px 10px;border-radius:100px;white-space:nowrap}
  .graph-badge .up{width:0;height:0;border-left:4px solid transparent;border-right:4px solid transparent;border-bottom:6px solid var(--green-action)}
  .chart{width:100%;height:210px;display:block}
  .grid-line{stroke:var(--line);stroke-width:1}
  .area{fill:url(#areaGrad)}
  .line{fill:none;stroke:var(--green-action);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
  .dot{fill:#fff;stroke:var(--green-action);stroke-width:2.5}
  .dot-live{fill:var(--green-action)}
  .pulse{fill:var(--green);opacity:.25}
  .xlabels{display:flex;justify-content:space-between;margin-top:2px;font-size:11px;color:var(--muted);padding:0 4px}
  .chart-note{margin-top:10px;font-size:11px;color:#94a3b8;text-align:right;font-style:italic}
</style>

<script>
  const svg = document.querySelector('[data-growth]') as SVGSVGElement | null;
  if (svg) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const W = 460, H = 210;
    const pts = [0.16,0.22,0.19,0.31,0.4,0.37,0.5,0.58,0.62,0.74,0.82,0.9];
    const xs = pts.map((_, i) => (i / (pts.length - 1)) * W);
    const ys = pts.map(v => H - 14 - v * (H - 40));
    const line = svg.querySelector('[data-line]')!, area = svg.querySelector('[data-area]')!,
          live = svg.querySelector('[data-live]')!, pulse = svg.querySelector('[data-pulse]')!;
    const pathTo = (n:number) => { let d = `M ${xs[0]} ${ys[0]}`; const full = Math.floor(n);
      for (let i=1;i<=full && i<xs.length;i++){const cx=(xs[i-1]+xs[i])/2; d+=` C ${cx} ${ys[i-1]} ${cx} ${ys[i]} ${xs[i]} ${ys[i]}`;} return d; };
    const endPt = (n:number) => { const i=Math.min(Math.floor(n),xs.length-1); const f=Math.min(n-i,1); const j=Math.min(i+1,xs.length-1);
      return [xs[i]+(xs[j]-xs[i])*f, ys[i]+(ys[j]-ys[i])*f]; };
    const render = (p:number) => { const n=p*(xs.length-1); const d=pathTo(n); const [ex,ey]=endPt(n);
      line.setAttribute('d',d); area.setAttribute('d', d+` L ${ex} ${H} L ${xs[0]} ${H} Z`);
      live.setAttribute('cx',''+ex); live.setAttribute('cy',''+ey); live.setAttribute('r', p>0.02?'4.5':'0');
      pulse.setAttribute('cx',''+ex); pulse.setAttribute('cy',''+ey); };
    render(0);
    const run = () => { if (reduce){ render(1); return; }
      const dur=1500, t0=performance.now();
      const frame=(t:number)=>{ const p=Math.min((t-t0)/dur,1); render(1-Math.pow(1-p,3));
        if (p<1) requestAnimationFrame(frame);
        else (function loop(){ pulse.setAttribute('r', ''+(9+3*Math.sin(performance.now()/380))); requestAnimationFrame(loop); })(); };
      requestAnimationFrame(frame); };
    const gio = new IntersectionObserver((es)=>es.forEach(e=>{ if(e.isIntersecting){ run(); gio.disconnect(); }}), {threshold:.35});
    gio.observe(svg);
  }
</script>
