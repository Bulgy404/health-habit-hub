---
import { useT, links, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<div class="badges">
  <a class="badge ios" href={links.appStore} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.365 1.43c0 1.14-.417 2.2-1.11 2.98-.83.94-2.19 1.66-3.32 1.57-.14-1.09.42-2.24 1.06-2.95.72-.8 1.98-1.42 3.02-1.6.03.33.35.68.35 0zM20.5 17.02c-.55 1.27-.82 1.83-1.53 2.95-.99 1.57-2.39 3.52-4.12 3.53-1.54.02-1.94-1.01-4.03-1-2.09.01-2.53 1.02-4.07 1-1.73-.02-3.05-1.78-4.04-3.35C.02 16.9-.28 12.4 1.34 10c1.15-1.72 2.96-2.72 4.66-2.72 1.73 0 2.82 1 4.25 1 1.39 0 2.24-1 4.24-1 1.51 0 3.11.82 4.25 2.24-3.73 2.05-3.13 7.38.76 8.5z"/></svg>
    <span><small>{t('p_ios')}</small><strong>App Store</strong></span>
  </a>
  <span class="badge android soon" aria-disabled="true">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5v-17c0-.4.2-.8.6-1L14 9l-3 3-8 8.5zM14.5 12.5l2.5 2.5-11.4 6.6L14.5 12.5zm4.9-3.4l2.4 1.4c.7.4.7 1.4 0 1.8l-2.4 1.4L16.5 12l2.9-2.9zM5.6 2.5L17 9l-2.5 2.5L5.6 2.5z"/></svg>
    <span><small>{t('soon')}</small><strong>Google Play</strong></span>
  </span>
</div>
<style>
  .badges{display:flex;gap:12px;flex-wrap:wrap}
  .badge{display:inline-flex;align-items:center;gap:11px;padding:10px 18px;border-radius:13px;border:1px solid transparent;transition:transform .14s,box-shadow .2s}
  .badge svg{width:22px;height:22px;flex:0 0 auto}
  .badge span{display:flex;flex-direction:column;line-height:1.15}
  .badge small{font-size:10.5px;opacity:.8}
  .badge strong{font-size:15px;font-weight:600}
  .badge.ios{background:#0f172a;color:#fff}
  .badge.ios:active{transform:scale(.97)}
  .badge.ios:hover{box-shadow:0 8px 20px rgba(15,23,42,.28)}
  .badge.soon{background:var(--surface);border-color:var(--line);color:var(--muted);cursor:default}
  .badge.soon strong{color:var(--ink)}
</style>
