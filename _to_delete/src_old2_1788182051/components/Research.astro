---
import { useT, links, type Lang } from '../i18n/ui';
import { Image } from 'astro:assets';
import ContactForm from './ContactForm.astro';
import adminPortal from '../assets/mockups/adminPortal.png';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const caps = [
  ['r_cap_1_t','r_cap_1_p'],['r_cap_2_t','r_cap_2_p'],['r_cap_3_t','r_cap_3_p'],
  ['r_cap_4_t','r_cap_4_p'],['r_cap_5_t','r_cap_5_p'],['r_cap_6_t','r_cap_6_p'],
];
const arch = [
  ['r_arch_app','r_arch_app_d'],['r_arch_api','r_arch_api_d'],['r_arch_auth','r_arch_auth_d'],
  ['r_arch_data','r_arch_data_d'],['r_arch_rec','r_arch_rec_d'],['r_arch_edge','r_arch_edge_d'],
];
---
<header class="r-hero">
  <div class="wrap r-hero-in reveal">
    <span class="eyebrow">{t('nav_research')}</span>
    <h1>{t('r_hero_title')}</h1>
    <p class="lead">{t('r_hero_lead')}</p>
    <div class="r-cta">
      <a class="btn btn-primary btn-lg" href={links.admin}>{t('r_admin_btn')} &rarr;</a>
      <a class="btn btn-ghost btn-lg" href={links.github}>{t('r_docs_btn')}</a>
    </div>
  </div>
</header>

<section class="shot">
  <div class="wrap reveal">
    <div class="shot-frame"><Image src={adminPortal} alt={t('r_shot_cap')} widths={[640,960,1200]} sizes="(max-width:1160px) 92vw, 1104px" /></div>
    <p class="cap">{t('r_shot_cap')}</p>
  </div>
</section>

<!-- ARCHITECTURE, one animated line -->
<section class="arch">
  <div class="wrap">
    <div class="reveal"><span class="eyebrow">{t('r_arch_eyebrow')}</span><h2 class="sec-title">{t('r_arch_title')}</h2><p class="sec-sub">{t('r_arch_p')}</p></div>
    <div class="arch-scroll reveal">
      <div class="arch-track" data-arch>
        <div class="arch-line"><span class="pulse" data-arch-pulse></span></div>
        {arch.map(([k,d], i) => (
          <div class="node" style={`--i:${i}`}>
            <span class="dot"></span>
            <strong>{t(k)}</strong>
            <small>{t(d)}</small>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="reveal"><span class="eyebrow">{t('r_cap_eyebrow')}</span><h2 class="sec-title">{t('r_cap_title')}</h2></div>
    <div class="cap-grid">
      {caps.map(([tt,pp]) => (
        <div class="cap-card reveal"><h3>{t(tt)}</h3><p>{t(pp)}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="kontakt" class="contact">
  <div class="wrap contact-in">
    <div class="contact-txt reveal">
      <span class="eyebrow">{t('r_contact_eyebrow')}</span>
      <h2>{t('r_contact_title')}</h2>
      <p>{t('r_contact_p')}</p>
    </div>
    <div class="contact-form reveal"><ContactForm lang={lang} /></div>
  </div>
</section>

<style>
  .r-hero{padding:88px 0 40px}
  .r-hero-in{max-width:42ch}
  .r-hero h1{font-size:clamp(34px,4.6vw,54px);margin:14px 0 0}
  .r-hero .lead{font-size:clamp(17px,1.9vw,20px);color:var(--muted);margin:22px 0 30px;max-width:56ch;line-height:1.65}
  .r-cta{display:flex;gap:14px;flex-wrap:wrap}
  .shot{padding:24px 0 40px}
  .shot-frame{border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 40px 80px -40px rgba(15,23,42,.34);background:var(--surface)}
  .shot-frame :global(img){width:100%;height:auto;display:block}
  .shot .cap{color:var(--muted);font-size:14.5px;margin-top:16px;max-width:74ch;line-height:1.6}

  .arch{background:var(--surface-alt);padding:80px 0}
  .arch-scroll{margin-top:44px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px}
  .arch-track{position:relative;display:flex;align-items:flex-start;gap:0;min-width:760px}
  .arch-line{position:absolute;left:6%;right:6%;top:9px;height:2px;background:linear-gradient(90deg,var(--green-soft),var(--green-dark));border-radius:2px;overflow:visible}
  .arch-line .pulse{position:absolute;top:50%;left:0;width:12px;height:12px;border-radius:50%;background:var(--green-action);transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(69,183,0,.18)}
  .node{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 8px}
  .node .dot{width:20px;height:20px;border-radius:50%;background:var(--surface);border:2px solid var(--green-action);position:relative;z-index:2;transition:transform .3s var(--ease-out),box-shadow .3s}
  .node.hot .dot{transform:scale(1.25);box-shadow:0 0 0 6px rgba(69,183,0,.16)}
  .node strong{font-size:14.5px;margin-top:14px;font-weight:600}
  .node small{font-size:12.5px;color:var(--muted);margin-top:3px}

  .cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
  .cap-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:26px;transition:transform .3s var(--ease-out),box-shadow .3s,border-color .3s}
  .cap-card:hover{border-color:#cbd5e1;box-shadow:0 14px 34px rgba(15,23,42,.07);transform:translateY(-3px)}
  .cap-card h3{font-size:18px}
  .cap-card p{color:var(--muted);font-size:14.5px;margin-top:8px;line-height:1.6}

  .contact{background:var(--slate);color:#e2e8f0;padding:84px 0}
  .contact-in{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:start}
  .contact .eyebrow{color:var(--green-soft)}
  .contact-txt h2{color:#fff;font-size:clamp(26px,3.2vw,38px);margin-top:12px}
  .contact-txt p{color:#94a3b8;margin-top:14px;font-size:16px;line-height:1.65;max-width:38ch}
  .contact-form :global(label){color:#e2e8f0}
  .contact-form :global(input),.contact-form :global(textarea){background:#1a2536;border-color:#334155;color:#fff}
  .contact-form :global(.cf-hint){color:#94a3b8}
  @media(max-width:900px){.cap-grid{grid-template-columns:1fr}.contact-in{grid-template-columns:1fr;gap:32px}}
</style>

<script>
  // architecture: a data pulse travels the line; nodes light up as it passes
  const track = document.querySelector('[data-arch]') as HTMLElement | null;
  const pulse = document.querySelector('[data-arch-pulse]') as HTMLElement | null;
  if (track && pulse){
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nodes = Array.from(track.querySelectorAll('.node')) as HTMLElement[];
    if (reduce){ pulse.style.display='none'; }
    else {
      let started = false;
      const io = new IntersectionObserver((es)=>es.forEach(e=>{ if(e.isIntersecting && !started){ started=true; run(); }}),{threshold:.4});
      io.observe(track);
      function run(){
        const dur = 4200, t0 = performance.now();
        function frame(t:number){
          const p = ((t - t0) % dur) / dur;         // 0..1 loop, constant speed
          pulse.style.left = (p*100)+'%';
          const active = Math.round(p*(nodes.length-1));
          nodes.forEach((n,i)=> n.classList.toggle('hot', i===active));
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
    }
  }
</script>
