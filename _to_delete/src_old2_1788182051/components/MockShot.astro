---
import { Image } from 'astro:assets';
const { src, alt } = Astro.props as { src: ImageMetadata; alt: string };
---
<div class="shot" data-shot>
  <Image src={src} alt={alt} widths={[320, 480, 640]} sizes="(max-width:900px) 70vw, 320px" />
</div>
<style>
  .shot{width:min(320px,74vw);margin:0 auto}
  .shot :global(img){width:100%;height:auto;display:block;border-radius:26px;
    box-shadow:0 40px 80px -32px rgba(15,23,42,.42), 0 0 0 1px rgba(15,23,42,.04);
    clip-path:inset(0 0 0 0)}
  /* reveal from the bottom on scroll (Emil: clip-path reveal) */
  html.js .shot :global(img){clip-path:inset(0 0 100% 0);transition:clip-path .8s var(--ease-out),transform .8s var(--ease-out);transform:translateY(14px)}
  html.js .shot.in :global(img){clip-path:inset(0 0 0 0);transform:none}
  @media (prefers-reduced-motion: reduce){html.js .shot :global(img){clip-path:none;transform:none;transition:none}}
</style>
<script>
  const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.3});
  document.querySelectorAll('[data-shot]').forEach(el=>io.observe(el));
</script>
