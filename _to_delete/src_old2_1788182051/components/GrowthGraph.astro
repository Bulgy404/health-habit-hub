---
import { useT, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<figure class="graph-card reveal">
  <figcaption class="graph-head">
    <div class="gt">{t('chart_title')}</div>
    <p class="gs">{t('chart_sub')}</p>
  </figcaption>
  <div class="plot">
    <div class="yaxis"><span>{t('chart_y_high')}</span><span>{t('chart_y_low')}</span></div>
    <svg class="chart" data-growth viewBox="0 0 460 220" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#45b700" stop-opacity="0.20"/>
          <stop offset="100%" stop-color="#45b700" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <line class="grid-line" x1="0" y1="46"  x2="460" y2="46"/>
      <line class="grid-line" x1="0" y1="100" x2="460" y2="100"/>
      <line class="grid-line" x1="0" y1="154" x2="460" y2="154"/>
      <line class="grid-line" x1="0" y1="200" x2="460" y2="200"/>
      <path class="area" data-area d=""/>
      <path class="line" data-line d=""/>
      <circle class="dot-live" data-live r="0"/>
    </svg>
  </div>
  <div class="xlabels"><span>{t('w1')}</span><span>{t('w2')}</span><span>{t('w3')}</span></div>
  <p class="chart-note">{t('chart_note')}</p>
</figure>

<style>
  .graph-card{margin:0;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:26px 26px 18px;box-shadow:0 30px 60px -30px rgba(15,23,42,.24)}
  .graph-head{margin:0 0 18px}
  .graph-head .gt{font-family:'Fraunces Variable',serif;font-weight:500;font-size:19px;letter-spacing:-.01em}
  .graph-head .gs{font-size:13.5px;color:var(--muted);margin-top:6px;line-height:1.5}
  .plot{display:flex;gap:10px}
  .yaxis{display:flex;flex-direction:column;justify-content:space-between;padding:2px 0 8px;font-size:10.5px;color:#94a3b8;text-align:right;line-height:1.2;width:88px;flex:0 0 auto}
  .chart{flex:1;height:220px;display:block}
  .grid-line{stroke:var(--line);stroke-width:1}
  .area{fill:url(#areaGrad)}
  .line{fill:none;stroke:var(--green-action);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
  .dot-live{fill:var(--green-action);filter:drop-shadow(0 0 6px rgba(46,140,0,.4))}
  .xlabels{display:flex;justify-content:space-between;margin:4px 0 0 98px;font-size:11px;color:var(--muted)}
  .chart-note{margin-top:12px;font-size:11px;color:#94a3b8;font-style:italic}
  @media(max-width:520px){.yaxis{width:64px}.xlabels{margin-left:74px}}
</style>

<script>
  const svg = document.querySelector('[data-growth]') as SVGSVGElement | null;
  if (svg) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const W = 460, H = 220;
    // a slow, believable climb from effort toward routine, with small real-life wobble
    const pts = [0.10,0.14,0.12,0.20,0.26,0.24,0.33,0.40,0.44,0.55,0.60,0.66,0.75,0.80,0.88];
    const xs = pts.map((_, i) => (i / (pts.length - 1)) * W);
    const ys = pts.map(v => H - 16 - v * (H - 44));
    const line = svg.querySelector('[data-line]')!, area = svg.querySelector('[data-area]')!, live = svg.querySelector('[data-live]')!;
    const pathTo = (n:number) => { let d = `M ${xs[0]} ${ys[0]}`; const full = Math.floor(n);
      for (let i=1;i<=full && i<xs.length;i++){const cx=(xs[i-1]+xs[i])/2; d+=` C ${cx} ${ys[i-1]} ${cx} ${ys[i]} ${xs[i]} ${ys[i]}`;} return d; };
    const endPt = (n:number) => { const i=Math.min(Math.floor(n),xs.length-1); const f=Math.min(n-i,1); const j=Math.min(i+1,xs.length-1);
      return [xs[i]+(xs[j]-xs[i])*f, ys[i]+(ys[j]-ys[i])*f]; };
    const render = (p:number) => { const n=p*(xs.length-1); const d=pathTo(n); const [ex,ey]=endPt(n);
      line.setAttribute('d',d); area.setAttribute('d', d+` L ${ex} ${H} L ${xs[0]} ${H} Z`);
      live.setAttribute('cx',''+ex); live.setAttribute('cy',''+ey); live.setAttribute('r', p>0.01?'4.5':'0'); };
    render(0);
    const run = () => { if (reduce){ render(1); return; }
      const dur = 3200, t0 = performance.now();          // slow, deliberate growth
      const frame = (t:number) => { const p = Math.min((t - t0)/dur, 1);
        render(1 - Math.pow(1 - p, 2.4));                 // gentle ease-out, no snap
        if (p < 1) requestAnimationFrame(frame); };
      requestAnimationFrame(frame); };
    const io = new IntersectionObserver((es)=>es.forEach(e=>{ if(e.isIntersecting){ run(); io.disconnect(); }}), {threshold:.3});
    io.observe(svg);
  }
</script>
