---
import { useT, routes, links, type Lang } from '../i18n/ui';
import GrowthGraph from './GrowthGraph.astro';
import HabitNetwork from './HabitNetwork.astro';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang); const R = routes;
const titleHtml = t('home_title').replace(t('home_title_em'), `<em>${t('home_title_em')}</em>`);
---
<header class="hero">
  <div class="hero-bg"></div>
  <div class="wrap hero-grid">
    <div>
      <h1 class="title reveal" set:html={titleHtml}></h1>
      <p class="lead reveal">{t('home_lead')}</p>
      <div class="hero-cta reveal">
        <a class="btn btn-primary btn-lg" href={R.participants[lang]}>{t('home_cta_part')}</a>
        <a class="btn btn-ghost btn-lg" href={R.research[lang]}>{t('home_cta_res')}</a>
      </div>
      <ul class="hero-meta reveal">
        <li><span class="tick"></span>{t('meta_devices')}</li>
        <li><span class="tick"></span>{t('meta_gdpr')}</li>
        <li><span class="tick"></span>{t('meta_open')}</li>
      </ul>
    </div>
    <GrowthGraph lang={lang} />
  </div>
</header>

<!-- TWO PERSPECTIVES -->
<section class="persp">
  <div class="wrap">
    <div class="persp-head reveal">
      <span class="janus" aria-hidden="true">
        <svg viewBox="0 0 96 96" fill="none">
          <circle cx="48" cy="48" r="45" stroke="var(--green)" stroke-width="2" opacity=".35"/>
          <!-- left profile -->
          <path d="M48 20c-9 0-14 7-15 14-1 5-4 6-4 10 0 3 3 4 3 7 0 4-2 5-2 9 0 5 5 8 12 8V20z"
                fill="var(--green-dark)"/>
          <!-- right profile (mirrored) -->
          <path d="M48 20c9 0 14 7 15 14 1 5 4 6 4 10 0 3-3 4-3 7 0 4 2 5 2 9 0 5-5 8-12 8V20z"
                fill="var(--green-soft)"/>
          <circle cx="40" cy="42" r="2.4" fill="#fff"/>
          <circle cx="56" cy="42" r="2.4" fill="#fff"/>
        </svg>
      </span>
      <span class="eyebrow">{t('what_eyebrow')}</span>
      <h2 class="sec-title" style="margin-inline:auto">{t('what_title')}</h2>
      <p class="sec-sub" style="margin-inline:auto">{t('what_sub')}</p>
    </div>
    <div class="persp-sides">
      <div class="side reveal"><h3>{t('what_side_p_t')}</h3><p>{t('what_side_p_p')}</p></div>
      <div class="side-div" aria-hidden="true"></div>
      <div class="side reveal"><h3>{t('what_side_r_t')}</h3><p>{t('what_side_r_p')}</p></div>
    </div>
  </div>
</section>

<!-- SHARED HABIT GRAPH (neo4j) -->
<section class="graph-sec">
  <div class="wrap">
    <div class="graph-intro reveal">
      <span class="eyebrow">{t('graph_eyebrow')}</span>
      <h2 class="sec-title">{t('graph_title')}</h2>
      <p class="sec-sub">{t('graph_sub')}</p>
    </div>
    <HabitNetwork lang={lang} />
  </div>
</section>

<!-- FORK -->
<section class="fork">
  <div class="wrap">
    <div class="fork-head reveal">
      <span class="eyebrow">{t('fork_eyebrow')}</span>
      <h2>{t('fork_title')}</h2>
      <p class="sub">{t('fork_sub')}</p>
    </div>
    <div class="paths">
      <a class="path reveal" href={R.participants[lang]}>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></div>
        <div class="role-q">{t('fork_p_q')}</div><h3>{t('fork_p_t')}</h3><p>{t('fork_p_p')}</p>
        <span class="go">{t('fork_p_go')} <span class="arr">&rarr;</span></span>
      </a>
      <a class="path reveal" href={R.research[lang]}>
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.7"><path d="M9 3v6l-5 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-9V3"/><path d="M8 3h8"/></svg></div>
        <div class="role-q">{t('fork_r_q')}</div><h3>{t('fork_r_t')}</h3><p>{t('fork_r_p')}</p>
        <span class="go">{t('fork_r_go')} <span class="arr">&rarr;</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero{position:relative;overflow:hidden;padding:76px 0 84px}
  .hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(720px 400px at 82% -10%,rgba(78,198,0,.13),transparent 60%),radial-gradient(560px 380px at -4% 112%,rgba(37,111,0,.07),transparent 55%)}
  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center}
  .title{font-size:clamp(40px,5.6vw,66px);max-width:15ch}
  .title :global(em){font-style:normal;color:var(--green-dark)}
  .lead{font-size:clamp(16.5px,1.7vw,19px);color:var(--muted);max-width:52ch;margin:24px 0 32px}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap}
  .hero-meta{list-style:none;margin:40px 0 0;padding:0;display:flex;flex-direction:column;gap:11px}
  .hero-meta li{display:flex;align-items:center;gap:11px;font-size:14.5px;color:var(--ink)}
  .hero-meta .tick{width:18px;height:18px;border-radius:50%;background:var(--green-tint);border:1px solid #bbf7d0;position:relative;flex:0 0 auto}
  .hero-meta .tick::after{content:"";position:absolute;left:5px;top:4px;width:5px;height:8px;border:solid var(--green-action);border-width:0 2px 2px 0;transform:rotate(45deg)}

  .persp{padding:84px 0;background:var(--surface)}
  .persp-head{text-align:center;max-width:64ch;margin:0 auto}
  .janus{display:inline-grid;place-items:center;width:76px;height:76px;margin-bottom:20px}
  .janus svg{width:76px;height:76px}
  .persp-sides{display:flex;align-items:stretch;justify-content:center;gap:0;max-width:760px;margin:44px auto 0}
  .side{flex:1;padding:0 34px}
  .side h3{font-size:19px}
  .side p{color:var(--muted);margin-top:8px;font-size:15px}
  .side-div{width:1px;background:var(--line)}

  .graph-sec{padding:84px 0}
  .graph-intro{max-width:62ch;margin-bottom:36px}

  .fork{background:var(--slate);color:#e2e8f0;padding:84px 0}
  .fork-head{text-align:center;max-width:62ch;margin:0 auto 48px}
  .fork .eyebrow{color:var(--green-soft)}
  .fork h2{color:#fff;font-size:clamp(30px,4vw,44px);margin-top:12px}
  .fork .sub{color:#94a3b8;margin-top:14px;font-size:17px}
  .paths{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .path{position:relative;background:#243044;border:1px solid #334155;border-radius:20px;padding:38px 34px;overflow:hidden;transition:transform .35s var(--ease-out),box-shadow .35s,border-color .35s;cursor:pointer;display:block}
  .path::before{content:"";position:absolute;inset:0;background:radial-gradient(440px 220px at 100% 0,rgba(78,198,0,.15),transparent 60%);opacity:0;transition:opacity .35s}
  .path:hover{transform:translateY(-5px);border-color:var(--green);box-shadow:0 26px 50px rgba(0,0,0,.36)}
  .path:active{transform:translateY(-2px) scale(.995)}
  .path:hover::before{opacity:1}
  .path .ic{width:52px;height:52px;border-radius:14px;background:rgba(69,183,0,.14);border:1px solid rgba(78,198,0,.3);display:grid;place-items:center;margin-bottom:22px}
  .path .ic svg{width:26px;height:26px;stroke:var(--green-soft)}
  .path h3{color:#fff;font-size:25px}
  .path .role-q{font-size:13px;color:var(--green-soft);font-weight:600;margin-bottom:6px}
  .path p{color:#94a3b8;font-size:15px;margin:12px 0 22px;line-height:1.6}
  .path .go{display:inline-flex;align-items:center;gap:8px;color:#fff;font-weight:600;font-size:14.5px}
  .path .go .arr{transition:transform .25s var(--ease-out)}
  .path:hover .go .arr{transform:translateX(5px)}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:40px}.paths{grid-template-columns:1fr}.persp-sides{flex-direction:column;gap:24px}.side-div{width:auto;height:1px}}
</style>
