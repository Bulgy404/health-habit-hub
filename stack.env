# Portainer Stack Environment File
# This file is used by Portainer when deploying from Git repository
# IMPORTANT: Override these values in Portainer's environment variables section
# Do NOT commit real passwords to Git!

# Domain Configuration — OVERRIDE IN PORTAINER
DOMAIN=your-domain.example.com
SERVER_IP=x.x.x.x
# Traefik host port bindings. Change TRAEFIK_HTTP_PORT to any unused port (e.g. 18080)
# when running a second instance on the same server so both don't compete for port 80.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
# Neo4j Browser's bolt-over-websocket channel — needs its own port on this
# same domain (no path routing possible for it, no new DNS record needed).
# Open this port in your firewall/security group too.
NEO4J_BOLT_PORT=7687

# Let's Encrypt Configuration — OVERRIDE IN PORTAINER
ACME_EMAIL=your-email@example.com

# ══ Internal-tool access = Keycloak SSO (no more htpasswd hashes) ════════════
# Prometheus, Bull Board, RedisInsight, Neo4j Browser and mongo-express are
# gated by oauth2-proxy against Keycloak: you log in with your normal Keycloak
# account, and only accounts holding the realm `admin` role get in. There are no
# tool passwords or hashes to manage anymore — just two secrets for oauth2-proxy:
#   OAUTH2_PROXY_CLIENT_SECRET — must match the `oauth2-proxy` Keycloak client
#     (injected into Keycloak by keycloak-init, same pattern as GRAFANA_CLIENT_SECRET).
#   OAUTH2_PROXY_COOKIE_SECRET — 32-byte random; signs the SSO session cookie.
#     Generate: openssl rand -base64 24   (MUST be 16/24/32 chars — base64 of
#     32 bytes is 44 chars and oauth2-proxy rejects it; base64 of 24 = 32 chars)
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_THIS_OAUTH2_PROXY_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_THIS_32_BYTE_RANDOM

# LightRAG is not on the SSO (it can't do OIDC) — it uses its own login. Set a
# plaintext password (username is `admin`) and a random JWT signing secret.
#   LIGHTRAG_TOKEN_SECRET — random; e.g. openssl rand -hex 32
LIGHTRAG_AUTH_PASSWORD=CHANGE_THIS_LIGHTRAG_PASSWORD
LIGHTRAG_TOKEN_SECRET=CHANGE_THIS_LIGHTRAG_TOKEN_SECRET

# App Configuration
APP_BASE_PATH=/
NODE_ENV=production

# Translation Service Configuration
LT_LOAD_ONLY=de,en,ja
LT_REQ_LIMIT=0
LT_DEBUG=false
LT_DISABLE_WEB_UI=false

# Database Passwords - OVERRIDE IN PORTAINER!
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# MongoDB Configuration
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_THIS_MONGO_PASSWORD
MONGO_DB=surveyjs
MONGO_AUTH_SOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=30000

# Graph Storage Backend
GRAPH_BACKEND=neo4j

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_NEO4J_PASSWORD

# Mail Configuration (generic SMTP) - OVERRIDE IN PORTAINER!
# Used for critical-alert emails: backup failures, LLM outages, BullMQ job
# failures, and service-reachability/5xx alerts (Grafana). Any SMTP
# relay/provider works.
SMTP_HOST=CHANGE_THIS_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_THIS_SMTP_USER
SMTP_PASS=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM=noreply@your-domain.example.com
SMTP_STARTTLS=true

# Backup Configuration
BACKUP_RETENTION_DAYS=14
ALERT_EMAIL=your-email@example.com

# Optional: Webhook URL for Slack/Discord/Teams notifications
ALERT_WEBHOOK_URL=

# Grafana admin login (also used for OAuth-role fallback) - OVERRIDE IN PORTAINER!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Keycloak Configuration - OVERRIDE IN PORTAINER!
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_THIS_KEYCLOAK_PASSWORD
# Admin portal login username (HHH realm); password = KEYCLOAK_ADMIN_PASSWORD
HHH_ADMIN_USER=admin
# Keycloak PostgreSQL database credentials - OVERRIDE IN PORTAINER!
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_THIS_KC_DB_PASSWORD

# Keycloak client secrets - OVERRIDE IN PORTAINER!
# keycloak-init pushes each of these into its matching Keycloak client at
# startup (kcadm.sh update clients/<id> -s secret=...). If any is left
# unset, the client's secret is silently set to an EMPTY STRING, breaking
# that integration (backend<->Keycloak auth, admin panel login, or Grafana
# SSO) until manually fixed in the Keycloak admin console.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_BACKEND_SECRET
KEYCLOAK_ADMIN_UI_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_ADMIN_UI_SECRET
GRAFANA_CLIENT_SECRET=CHANGE_THIS_GRAFANA_CLIENT_SECRET
# Confidential client used server-side only (onboarding, credential
# rotation, passphrase-based account restore) to mint token pairs via the
# OAuth password grant. Required in production — mintTokenForUser() refuses
# to mint tokens if this is unset, so an empty value breaks account restore.
KEYCLOAK_ROPC_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_ROPC_SECRET

# Admin Panel
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET

# Recommender Service Configuration
RECOMMENDER_URL=http://recommender:8000
API_SERVICE_SECRET=CHANGE_THIS_API_SERVICE_SECRET

# LLM Configuration (used by API-service for habit classification, context extraction,
# and recommendations)
# OVERRIDE IN PORTAINER with your actual API key!
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# LLM model to use (e.g. gpt-4o-mini for cost efficiency, gpt-4o for higher accuracy)
LLM_MODEL=gpt-4o-mini

# LLM sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2
