{
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "format:check": "npx prettier --check .",
    "format:fix": "npx prettier --write .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint --fix .",
    "test:unitTests": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:backup": "node --test tests/BackupConfiguration.test.js",
    "test:neo4j": "ENABLE_INTEGRATION=1 node --test tests/Neo4jDatabase.test.js",
    "test:fuseki": "ENABLE_INTEGRATION=1 node --test tests/FusekiDatabase.integration.test.js",
    "test:mongo": "ENABLE_INTEGRATION=1 node --test tests/Mongo.test.js",
    "test:translate": "ENABLE_INTEGRATION=1 node --test tests/TranslateService.test.js",
    "test:integration": "npm run test:neo4j && npm run test:fuseki && npm run test:mongo && npm run test:translate",
    "test:coverage": "c8 --include='middleware/**' --include='controllers/**' --include='routes/**' --include='services/**' --reporter=text node --test \"tests/unit/**/*.test.js\"",
    "test": "npm run format:check && npm run lint && npm run test:unitTests",
    "generate-spec": "node ../scripts/generate-spec.js",
    "version-check": "node ../scripts/version-check.js",
    "seed": "node ../scripts/seed-local.js",
    "seed:study": "node ../scripts/seed-study.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-recaptcha": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "marked": "^16.0.0",
    "mongodb": "^6.17.0",
    "neo4j-driver": "^5.22.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sparql-http-client": "^2.4.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.19.0"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "lodash": "^4.17.24",
    "protobufjs": "^7.5.5"
  },
  "type": "module",
  "devDependencies": {
    "@angelventura/eslint-plugin-ejs": "^0.2.0",
    "@eslint/js": "^9.4.0",
    "c8": "^11.0.0",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.1",
    "eslint-plugin-json": "^4.0.0",
    "globals": "^15.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.0"
  }
}
