  {
    "_id": "questionnaire-sliq",
    "slug": "sliq",
    "title": "Short Lifestyle Indicator Questionnaire (SLIQ)",
    "description": "A validated 4-item instrument measuring diet quality, physical activity, smoking, and alcohol consumption.",
    "version": "1.0.0",
    "active": true,
    "questions": [
      {
        "id": "sliq_diet",
        "text": "How would you rate your overall diet?",
        "type": "single_choice",
        "options": [
          {
            "value": "0",
            "label": "Very unhealthy (eat lots of junk food, very few fruits/vegetables)"
          },
          {
            "value": "1",
            "label": "Unhealthy (eat some junk food, few fruits/vegetables)"
          },
          {
            "value": "2",
            "label": "Reasonably healthy (limit junk food, eat some fruits/vegetables)"
          },
          {
            "value": "3",
            "label": "Very healthy (rarely eat junk food, eat lots of fruits/vegetables)"
          }
        ],
        "required": true
      },
      {
        "id": "sliq_physical_activity",
        "text": "How much moderate or vigorous physical activity do you do per week?",
        "type": "single_choice",
        "options": [
          {
            "value": "0",
            "label": "None"
          },
          {
            "value": "1",
            "label": "Less than 30 minutes"
          },
          {
            "value": "2",
            "label": "30–149 minutes"
          },
          {
            "value": "3",
            "label": "150 minutes or more"
          }
        ],
        "required": true
      },
      {
        "id": "sliq_smoking",
        "text": "Which best describes your smoking status?",
        "type": "single_choice",
        "options": [
          {
            "value": "0",
            "label": "I currently smoke daily"
          },
          {
            "value": "1",
            "label": "I currently smoke, but not daily"
          },
          {
            "value": "2",
            "label": "I used to smoke but have quit"
          },
          {
            "value": "3",
            "label": "I have never smoked"
          }
        ],
        "required": true
      },
      {
        "id": "sliq_alcohol",
        "text": "How many standard alcoholic drinks do you consume per week on average?",
        "type": "single_choice",
        "options": [
          {
            "value": "0",
            "label": "14 or more drinks"
          },
          {
            "value": "1",
            "label": "8–13 drinks"
          },
          {
            "value": "2",
            "label": "1–7 drinks"
          },
          {
            "value": "3",
            "label": "I do not drink alcohol"
          }
        ],
        "required": true
      }
    ],
