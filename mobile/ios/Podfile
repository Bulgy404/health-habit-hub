# Uncomment this line to define a global platform for your project
platform :ios, '18.0'

# Silence warnings from third-party pod source (Firebase, Sentry, AppAuth, etc.).
# Only affects Pods targets, not Runner's own code.
inhibit_all_warnings!

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'

      # Xcode 16's Module Verifier compiles each pod as a standalone module to
      # sanity-check it, but Flutter plugin pods rely on header search paths
      # Flutter's own build step injects — those aren't present during
      # verification, so it fails with "Flutter/Flutter.h file not found"
      # (Release/Archive builds only). Disable verification for pods.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

      # Flutter's placeholder "Flutter" pod (satisfies plugin podspecs'
      # `s.dependency 'Flutter'`; real linking happens outside CocoaPods) has
      # no real sources, so libtool warns its archived object has no symbols.
      # Harmless — silence just that specific libtool diagnostic.
      other_libtoolflags = config.build_settings['OTHER_LIBTOOLFLAGS'] || ['$(inherited)']
      other_libtoolflags = [other_libtoolflags] if other_libtoolflags.is_a?(String)
      config.build_settings['OTHER_LIBTOOLFLAGS'] = other_libtoolflags + ['-no_warning_for_no_symbols']

      # firebase_core assigns [NSNull null] to NSString* pigeon properties (e.g.
      # deepLinkURLScheme) without an (id) cast. Xcode 15+ treats
      # -Wincompatible-pointer-types as an error by default, which breaks the
      # build. Demote it back to a warning until upstream fixes it.
      # https://github.com/firebase/flutterfire/ (FLTFirebaseCorePlugin.m)
      if target.name == 'firebase_core'
        other_cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
        other_cflags = [other_cflags] if other_cflags.is_a?(String)
        config.build_settings['OTHER_CFLAGS'] = other_cflags + ['-Wno-error=incompatible-pointer-types']
      end
    end
  end
end
