default_platform(:ios)

# Static app identifiers — not secret, already present in the committed
# Xcode project (ios/Runner.xcodeproj/project.pbxproj).
BUNDLE_IDENTIFIER = "de.felixreinsch.healthhabithub"
TEAM_ID = "M9D25U4X72"

platform :ios do
  before_all do
    # Creates a throwaway CI keychain and points MATCH_KEYCHAIN_NAME /
    # MATCH_KEYCHAIN_PASSWORD at it, so import_certificate below can find it
    # without us managing a keychain by hand. No-op outside CI.
    setup_ci if ENV["CI"]
  end

  # ---------------------------------------------------------------------
  # Shared building blocks
  # ---------------------------------------------------------------------

  desc "Authenticate with App Store Connect via API key (no Apple ID / 2FA)"
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true
    )
  end

  desc "Import the distribution certificate + provisioning profile CI decoded from secrets"
  private_lane :import_signing_assets do
    import_certificate(
      certificate_path: ENV.fetch("IOS_CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )
    install_provisioning_profile(path: ENV.fetch("IOS_PROVISIONING_PROFILE_PATH"))
  end

  # flutter build ipa needs an ExportOptions.plist for manual (non-Xcode-managed)
  # signing. Generated at build time rather than committed, since the exact
  # provisioning profile name lives in the Apple Developer portal and can be
  # rotated independently of this repo (see RELEASING.md).
  private_lane :write_export_options do
    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    plist = <<~PLIST
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>teamID</key>
        <string>#{TEAM_ID}</string>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>uploadBitcode</key>
        <false/>
        <key>uploadSymbols</key>
        <true/>
        <key>provisioningProfiles</key>
        <dict>
          <key>#{BUNDLE_IDENTIFIER}</key>
          <string>#{profile_name}</string>
        </dict>
      </dict>
      </plist>
    PLIST
    File.write("../ios/ExportOptions.plist", plist)
  end

  # ---------------------------------------------------------------------
  # Lanes
  # ---------------------------------------------------------------------

  desc "Build the app and upload a new build to TestFlight. Triggered by pushing a `mobile-v*` tag."
  lane :beta do
    api_key = asc_api_key
    import_signing_assets
    write_export_options

    build_number = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_IDENTIFIER
    ) + 1).to_s
    UI.message("Building build number #{build_number}")

    Dir.chdir("..") do
      sh(
        "flutter", "build", "ipa",
        "--release",
        "--build-number=#{build_number}",
        "--export-options-plist=ios/ExportOptions.plist"
      )
    end

    ipa_path = Dir.glob("../build/ios/ipa/*.ipa").first
    UI.user_error!("No .ipa found under build/ios/ipa — flutter build ipa may have failed.") if ipa_path.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit the latest processed TestFlight build for App Store review. Manual dispatch only — see RELEASING.md."
  lane :release do
    api_key = asc_api_key

    # Deliberately does not build/upload a new binary — it submits whatever
    # build the `beta` lane most recently pushed to TestFlight. Run `beta`
    # first, wait for Apple to finish processing it, then run this lane.
    deliver(
      api_key: api_key,
      app_identifier: BUNDLE_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true
    )
  end
end
