%% Health Habit Hub — System Architecture (C4-style container diagram)
%% Source of truth: docker-compose.yml, docs/architecture.md
%% Render: mmdc -i system-architecture.mmd -o system-architecture.svg

flowchart TB
    %% ------- Actors -------
    participant_actor(["👤 Participant<br/>(role: user)"])
    researcher_actor(["👤 Researcher / Admin"])
    agent_actor(["🤖 AI Agent<br/>(Claude / MCP client)"])

    %% ------- Clients -------
    subgraph clients["Clients"]
        flutter["Flutter App<br/>(iOS / Android / Web)<br/>Riverpod · GoRouter · Firebase"]
        adminui["Admin Panel<br/>Next.js 15 · React 18 · MUI<br/>NextAuth<br/>:3001"]
    end

    %% ------- Edge -------
    traefik["Traefik v3<br/>Reverse proxy · TLS (Let's Encrypt)<br/>:80 / :443 · bolt :7687"]
    oauth2proxy["oauth2-proxy<br/>Keycloak SSO forward-auth gate<br/>internal tools · admin role only"]

    %% ------- Application layer -------
    subgraph appsvc["Application Services (Docker, hhh-proxy network)"]
        backend["Node.js Backend<br/>Express · /api/v1/*<br/>:3000"]
        apiservice["API-service<br/>Python FastAPI · :8000<br/>classify · map-BCIO · recommend (RAG)"]
        knowledgemcp["knowledge-mcp<br/>FastMCP · SSE · :8002<br/>search_knowledge · ingest_document"]
        translate["LibreTranslate<br/>MT en↔de · :5000"]
    end

    %% ------- Identity -------
    keycloak["Keycloak 26<br/>OIDC / OAuth2 · realm hhh<br/>:8080"]

    %% ------- Data layer -------
    subgraph data["Data Stores"]
        mongo[("MongoDB 7<br/>studies · questionnaires · intentions<br/>logs · SRHI · recommendations · restore_attempts · habit_donations<br/>study_memberships · study_consent_documents")]
        neo4j[("Neo4j 5<br/>Habit / Context / BCIOConcept graph<br/>bolt :7687")]
        lightrag[("LightRAG · :9621<br/>graph + vector knowledge base")]
        redis[("Redis 7<br/>API-service response cache · BullMQ habitQueue")]
        postgres[("PostgreSQL 16<br/>Keycloak persistence")]
        mongoexpress["mongo-express<br/>admin-only Mongo UI · /mongo/"]
    end

    %% ------- External -------
    subgraph identity["Identity register — verified-identity studies only (hhh-identity-edge / hhh-identity-net)"]
        identitysvc["identity-service<br/>Node + Express<br/>:3002 admin · :3003 internal"]
        identitydb[("identity-db<br/>PostgreSQL<br/>envelope-encrypted PII")]
    end

    subgraph external["External Services"]
        llm["LLM Provider<br/>(OpenAI-compatible API)"]
        fcm["Firebase Cloud<br/>Messaging (FCM)"]
        smtp["SMTP relay<br/>enrolment invites · reveal alerts to the DPO"]
    end

    %% ------- Monitoring -------
    subgraph monitoring["Monitoring"]
        prometheus["Prometheus<br/>metrics · 30d retention"]
        grafana["Grafana<br/>dashboards · own Keycloak OIDC"]
        blackbox["blackbox-exporter<br/>endpoint probes"]
    end

    %% ------- Internal tools (behind oauth2-proxy SSO, admin role) -------
    subgraph tools["Internal tools — Keycloak SSO (admin role)"]
        redisinsight["RedisInsight<br/>/redisinsight"]
        bullboard["Bull Board<br/>/queues (served by backend)"]
        lightragui["LightRAG WebUI<br/>/lightrag · own login (not SSO)"]
    end

    %% ------- Ops -------
    dockerproxy["docker-socket-proxy<br/>scoped Docker API (no raw socket mount)"]
    backup["Backup Service<br/>~24h sleep-loop (not real cron) · configurable retention (default 14 days)"]

    %% ------- Edges: actors -------
    participant_actor --> flutter
    researcher_actor --> adminui
    agent_actor -- "MCP over SSE" --> knowledgemcp

    %% ------- Edges: clients → edge -------
    flutter -- "HTTPS REST + JWT" --> traefik
    adminui -- "HTTPS" --> traefik
    traefik -- "app.*" --> backend
    traefik -- "admin.*" --> adminui
    traefik -- "/auth" --> keycloak

    %% ------- Edges: auth -------
    flutter -. "OIDC Auth Code + PKCE" .-> keycloak
    adminui -. "OIDC (NextAuth, confidential client)" .-> keycloak
    backend -. "JWKS verify (RS256)" .-> keycloak
    keycloak --> postgres

    %% ------- Edges: backend -------
    backend --> mongo
    backend -- "Cypher / Bolt" --> neo4j
    backend -- "POST /translate" --> translate
    backend -- "/api/v1/llm/* · /api/v1/kb/*<br/>(service token)" --> apiservice
    backend -- "push campaigns" --> fcm

    %% ------- Edges: AI service -------
    apiservice -- "chat / embeddings" --> llm
    apiservice -- "hybrid query / ingest" --> lightrag
    apiservice -- "response cache<br/>(checked before RAG/LLM)" --> redis
    apiservice --> mongo
    apiservice -- "Bolt" --> neo4j
    knowledgemcp --> lightrag
    lightrag -- "entity extraction · embeddings" --> llm

    %% ------- Edges: ops -------
    backup -- "mongodump" --> mongo
    backup -- "neo4j-admin dump" --> neo4j
    backup -- "tar lightrag-data" --> lightrag
    backup -- "tar audio-recordings" --> backend
    backup -- "partial-export API" --> keycloak
    backup -- "docker exec (Keycloak DB dump)" --> dockerproxy
    mongoexpress --> mongo

    %% ------- Edges: internal-tool SSO -------
    researcher_actor -- "internal tools" --> traefik
    traefik -- "/prometheus /grafana /mongo /redisinsight /queues /neo4j" --> oauth2proxy
    oauth2proxy -. "forward-auth (302 → Keycloak)" .-> keycloak
    oauth2proxy -- "admin role OK" --> prometheus
    oauth2proxy --> grafana
    oauth2proxy --> mongoexpress
    oauth2proxy --> redisinsight
    oauth2proxy --> bullboard
    redisinsight --> redis
    lightragui -. "own AUTH_ACCOUNTS login" .-> lightrag

    %% ------- Edges: identity register (optional; absent unless a study is verified) -------
    traefik -- "/identity (admin portal)" --> identitysvc
    backend -- "internal :3003<br/>reserve / confirm / release<br/>NO PII crosses this edge" --> identitysvc
    identitysvc --> identitydb
    identitysvc -. "JWKS" .-> keycloak
    identitysvc -. "invite to the address held in the register;<br/>an alert on EVERY reveal" .-> smtp
    %% Deliberately absent: any edge from identitysvc to mongo or neo4j. The
    %% register is not on hhh-proxy, so no such route exists — asserted by
    %% app/tests/unit/identityIsolation.test.js.
    %%
    %% Also deliberately absent: any edge from identitysvc to Sentry. Stack
    %% traces capture local variables, which here would carry patient names
    %% across the trust boundary.

    %% ------- Edges: monitoring -------
    prometheus -. "scrape /metrics" .-> backend
    prometheus -. "scrape /metrics" .-> apiservice
    prometheus -. "probe" .-> blackbox
    grafana -. "OIDC SSO" .-> keycloak
    grafana --> prometheus

    classDef actor fill:#fff3cd,stroke:#b8860b
    classDef store fill:#e7f1ff,stroke:#2a6fb8
    classDef ext fill:#f3e8ff,stroke:#7c3aed
    classDef ops fill:#eafbe7,stroke:#2e8c00
    classDef tool fill:#ffe9e0,stroke:#d2601a
    class participant_actor,researcher_actor,agent_actor actor
    class mongo,neo4j,lightrag,redis,postgres store
    class llm,fcm ext
    class backup,dockerproxy,prometheus,grafana,blackbox ops
    class oauth2proxy,mongoexpress,redisinsight,bullboard,lightragui tool
    classDef identity fill:#fde2e2,stroke:#b02a37,stroke-width:2px
    class identitysvc,identitydb identity
