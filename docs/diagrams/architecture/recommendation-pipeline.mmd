%% M3 Recommendation Pipeline — data-flow view (single-LLM-call architecture)
flowchart TD
    INPUT(["`**POST /api/v1/llm/recommend**
    user_id · goal · session_id
    *Auth: X-Service-Auth-Token*`"])

    GUARD{"`Goal guard
    regex injection screen (EN+DE)`"}
    INPUT --> GUARD
    GUARD -->|injection / shady goal| REJ(["`**422** user-facing reason
    (never cached)`"])

    CACHE{"`Redis cache check
    GET recommend:{sha256(user_id‖goal)}`"}
    GUARD -->|clean| CACHE
    CACHE -->|hit| DONE(["`Return cached
    RecommendResponse`"])

    CACHE -->|miss| PARALLEL

    subgraph PARALLEL["Stage 1 — 7-way parallel data fetch  (asyncio.gather, zero LLM calls)"]
        direction TB

        subgraph PERSONAL["Personal habits  (1 Neo4j session)"]
            P1["`**Cypher:**
            MATCH (h:Habit {userID: $user_id, is_habit: true})
            OPTIONAL MATCH (h)-[:HAS_CONTEXT]->(c:Context)
            RETURN h.uuid,
                   coalesce(h.translationEN, h.sentence),
                   collect({dimension: c.dimension, text: c.text}),
                   h.embedding
            *LIMIT 200 rows*`"]
            P2["`cosine rank in Python
            → top USER_HABITS_LIMIT (default 10)`"]
            P1 --> P2
        end

        subgraph COMMUNITY["Community habits — 3-index fan-out  (3 parallel Neo4j sessions)"]
            C1["`**habit_embedding_idx** — sentence-level match`"]
            C2["`**context_embedding_idx** — situational / INTERNAL_STATE match`"]
            C3["`**bcio_embedding_idx** — behaviour-change concept match`"]
            CMERGE["`Merge by max(score) per UUID
            → top COMMUNITY_HABITS_LIMIT (default 10)`"]
            C1 & C2 & C3 --> CMERGE
        end

        subgraph ANNOT["Annotated habits  (MongoDB + Neo4j)"]
            AN1["`**MongoDB** habit_annotations
            db.find({userId, type: {$in: ['helpful','iDoThis','like']}})`"]
            AN2["`**Neo4j** — fetch by UUID with context`"]
            AN1 --> AN2
        end

        subgraph PROFILE["Profile data  (2 parallel HTTP calls, X-Service-Auth-Token)"]
            Q1["`GET /questionnaire-responses/service/{userId}
            enrollment → studyId → questionnaire slugs → latest responses
            → {[slug]: responseOrNull}  *(adapts to any study config)*`"]
            Q2["`GET /user-profile/service/{userId}`"]
        end

        subgraph STUDYCFG["Study group config  (resolved per participant)"]
            SC1["`GET /study-config/me  *(JWT)*
            enrollment → study → group →
            {cueConfig, activityTypeConfig, reminderConfig, autoDonate}`"]
        end

        FB_FETCH["`**MongoDB** recommendation_feedback
        .find({userId, goal}).sort({created_at:-1}).limit(10)`"]

        PREV_FETCH["`**MongoDB** recommendations
        last 5 sets → ≤15 previous titles
        *(anti-repetition context)*`"]
    end

    subgraph STAGE2["Stage 2 — deterministic processing  (zero LLM calls)"]
        direction TB
        BUILD["`**build_profile()** — _profile_builder.py
        template-assemble profile_summary, profile_detailed, rag_query
        from all study questionnaire responses + demographics  *(replaces LLM-2)*
        known slugs: human-readable labels; unknown slugs: raw key-value*`"]

        subgraph GDS["GDS FastRP community re-ranking  *(replaces LLM-1)*"]
            direction LR
            CENTROID["`Compute user graph centroid
            mean of user habits' fastrp_embedding vectors`"]
            HYBRID["`Hybrid score per community habit:
            0.5 × semantic_score (cosine vs goal embedding)
            0.3 × graph_score (cosine vs user centroid)
            0.2 × log-normalised likes`"]
            CENTROID --> HYBRID
        end

        BUILD & GDS
    end

    subgraph STAGE3["Stage 3 — parallel enrichment  (2-way asyncio.gather)"]
        BCIO["`**fetch_bcio_concepts()** — Neo4j
        MATCH (h)-[:HAS_CONTEXT]->(c)-[:MAPS_TO]->(b:BCIOConcept)
        → {uuid: [concept_label, ...]}`"]
        LR["`**LightRAG** POST /query
        {query: rag_query, mode: 'hybrid', only_need_context: true}
        timeout: 90 s
        → context capped at RECOMMEND_MAX_CONTEXT_CHARS
        → distinct file_paths extracted → paper citations`"]
    end

    RECOMMEND["`**Single LLM call** — recommend.txt
    model: LLM_RECOMMEND_MODEL (fallback LLM_MODEL) · temp 0.2
    max_tokens: LLM_RECOMMEND_MAX_TOKENS · system msg: goal = untrusted data
    output language = language of the goal
    vars:
      {goal}                    ← entry point (<<<delimited>>>)
      {profile_summary/detailed}← build_profile()
      {personal_habits_json}    ← personal habits + bcio_concepts (compact)
      {annotated_habits_json}   ← bookmarked habits + bcio_concepts
      {community_habits_json}   ← GDS-reranked community + bcio_concepts
      {sources_json}            ← LightRAG context (capped)
      {source_documents_json}   ← citable papers [{filename, citation}]
      {prior_feedback}          ← MongoDB comments
      {previous_titles}         ← anti-repetition list
    → {recommendations: [{title, body, rationale, suggested_cue,
       selected_habit_uuids, source_filenames}]}
    or {refused: true, reason} → **422**`"]

    STORE["`**Persist & cache**
    MongoDB recommendations.insertOne({...})
    Redis SETEX recommend:{sha256} 86400`"]

    OUT(["`Return **RecommendResponse**
    recommendation_id · recommendations · generated_at
    Each item: title · body · rationale · suggested_cue ·
    sources [{filename, title, url, citation}]
    *(selected_habit_uuids logged + stored in Mongo only —
    never sent to the client)*`"])

    PARALLEL --> STAGE2
    STAGE2 --> STAGE3
    STAGE3 --> RECOMMEND
    RECOMMEND --> STORE --> OUT

    style PERSONAL fill:#d8edf8,stroke:#4a90d9
    style COMMUNITY fill:#c8e4f4,stroke:#4a90d9
    style ANNOT fill:#f8eef8,stroke:#9a4ab0
    style PROFILE fill:#e8f8e8,stroke:#5a9a4a
    style STAGE2 fill:#fff3e0,stroke:#e65100
    style GDS fill:#ffe0b2,stroke:#e65100
    style STAGE3 fill:#fff8e8,stroke:#c9a020
    style RECOMMEND fill:#fce8e8,stroke:#d94a4a
