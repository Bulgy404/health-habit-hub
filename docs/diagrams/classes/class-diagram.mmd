%% Health Habit Hub — Domain Class Diagram
%% Derived from: app/models/*.js (MongoDB validators), docs/data-model.md,
%% and the Neo4j graph schema
%% Render: mmdc -i class-diagram.mmd -o class-diagram.svg

classDiagram
    direction LR

    %% ===================== Identity =====================
    class User {
        <<Keycloak>>
        +String sub
        +String username
        +String[] realmRoles  user|researcher|admin
        +String groupAttribute  G1..G4
    }
    class UserPreferences {
        <<MongoDB users>>
        +String userId
        +String preferredLanguage  en|de|ja
    }
    class Consent {
        <<MongoDB consents>>
        +ObjectId _id
        +String userId
        +String consentVersion  semver
        +String documentSlug  null = the platform document
        +String locale  en|de|ja|fr|nl
        +Date consentedAt
    }
    User "1" --> "0..1" UserPreferences : has
    User "1" --> "0..*" Consent : accepted (append-only)

    %% ===================== Study domain (DFG) =====================
    class Study {
        <<MongoDB studies>>
        +ObjectId _id
        +String name
        +String description
        +Boolean isDefault
        +Boolean isActive
        +ObjectId[] questionnaires
        +Date endDate
        +Date createdAt
        +Date updatedAt
    }
    class ExperimentGroup {
        <<embedded in Study>>
        +ObjectId id
        +String label
        +Int index  1..4
    }
    class CueConfig {
        <<embedded>>
        +String cueCount  single|multi
        +String cueSource  low_quality|high_quality|self_selected
        +ObjectId cuePoolId
        +String[] behaviorOptions
        +Int maxHabits
    }
    class StudyCode {
        <<MongoDB study_codes>>
        +ObjectId _id
        +String code
        +ObjectId studyId
        +ObjectId groupId
        +Int maxRedemptions
        +Int redemptionCount
        +Date expiresAt
    }
    class Enrollment {
        <<MongoDB enrollments>>
        +ObjectId _id
        +String userId
        +ObjectId studyId
        +ObjectId groupId
        +String studyCodeUsed  null on a verified study
        +String subjectCode  verified studies only
        +Date enrolledAt
        +Date lastActiveAt
        +Date droppedOutAt
        +Date[] reactivations
    }
    Study "1" *-- "1..4" ExperimentGroup : groups
    ExperimentGroup "1" o-- "0..1" CueConfig
    Enrollment "1" o-- "0..1" CueConfig : override
    StudyCode "*" --> "1" Study
    StudyCode "*" --> "1" ExperimentGroup
    Enrollment "*" --> "1" Study
    Enrollment "*" --> "1" ExperimentGroup
    Enrollment "*" --> "1" User
    Enrollment "*" ..> "0..1" StudyCode : redeemed via

    %% ===================== Verified identity =====================
    %% Deliberately in its own PostgreSQL, in a separate service. Using a
    %% different engine from the research stores makes it structurally
    %% impossible for the register to be swept into mongodump or into
    %% studyExportService's collection loop — that mistake would need a code
    %% change, not a mis-set connection string.
    %%
    %% The ONLY thing that crosses into the research databases is
    %% Enrollment.subjectCode. Read this diagram left to right and the boundary
    %% is the dashed edge below: everything to its right knows a code, and
    %% nothing to its right knows a person.
    class StudyRegister {
        <<PostgreSQL study_registers>>
        +UUID id
        +String hhhStudyId  Mongo ObjectId, as text
        +String subjectCodePrefix  frozen at creation
        +String studyName  display only
        +Bytes dekWrapped  under KEK_kekVersion
        +Int kekVersion
        +Int nextSubjectSeq  counter, not a row count
    }
    class Subject {
        <<PostgreSQL subjects>>
        +UUID id
        +String subjectCode  the only field that crosses
        +Bytes givenNameCt  AES-256-GCM, AAD = row + column
        +Bytes familyNameCt
        +Bytes dobCt
        +Bytes emailCt
        +Bytes emailBi  keyed blind index
        +Bytes personBi  duplicate WARNING only
        +String status
        +Date verifiedAt
    }
    class SubjectAccountLink {
        <<PostgreSQL subject_account_links>>
        +UUID id
        +Bytes keycloakSubCt
        +Bytes keycloakSubBi
        +Date supersededAt  one live link per subject
    }
    class EnrollmentCode {
        <<PostgreSQL enrollment_codes>>
        +UUID id
        +Bytes codeHash  HMAC, looked up by digest
        +Bytes codeCt  for reprinting only
        +String status  issued|reserved|redeemed|revoked|expired
        +UUID reservationId
        +Date expiresAt
    }
    class StudySiteAssignment {
        <<PostgreSQL study_site_assignments>>
        +String actorSub
        +String role  identity-manager|study-nurse|monitor
        +String siteId
    }
    class ReidentificationRequest {
        <<PostgreSQL reidentification_requests>>
        +UUID id
        +String subjectCode
        +String legalBasis
        +String reason  min 50 chars
        +String[] fieldsRequested
        +String status
        +String requestedBy
        +Date revealExpiresAt
        +Int revealCount  incremented by RETURNING
    }
    class ReidentificationApproval {
        <<PostgreSQL reidentification_approvals>>
        +String approvedBy
        +String decision
        +Date decidedAt
    }
    class IdentityAuditLog {
        <<PostgreSQL identity_audit_log>>
        +BigInt id
        +String actorSub
        +String[] actorRoles  as held at the time
        +String action
        +String sensitivity  list|write|pii_read|reveal|export
        +String subjectCode
        +String[] fields  NAMES, never values
        +Bytes ipHash
        +Int repeatCount  never collapses a reveal
    }

    StudyRegister "1" *-- "0..*" Subject : roster
    StudyRegister "1" *-- "0..*" StudySiteAssignment : who may work here
    StudyRegister "1" *-- "0..*" IdentityAuditLog
    Subject "1" *-- "0..*" SubjectAccountLink : at most one live
    Subject "1" *-- "0..*" EnrollmentCode
    ReidentificationRequest "1" *-- "1..2" ReidentificationApproval : four-eyes, enforced by TRIGGER
    Enrollment ..> Subject : subjectCode ONLY —\nno key, no join, no FK

    %% ===================== Study consent documents =====================
    class StudyConsentDocument {
        <<MongoDB study_consent_documents>>
        +ObjectId _id
        +String slug
        +String lang  en|de|ja|fr|nl
        +String body  markdown
        +String version  semver
        +String effectiveDate
        +String status  draft|published
        +Date updatedAt
    }
    class StudyMembership {
        <<MongoDB study_memberships>>
        +ObjectId _id
        +String userId
        +ObjectId studyId
        +String role  researcher|lead
        +String scope  read|export
    }
    Study "1" ..> "0..*" StudyConsentDocument : identity.consentDocumentSlug
    Study "1" *-- "0..*" StudyMembership : scoped access
    Consent ..> StudyConsentDocument : documentSlug + version
    StudyConsentDocument ..> StudyConsentDocument : a DB row overrides\nthe shipped file

    %% ===================== Habit formation (DFG) =====================
    class ImplementationIntention {
        <<MongoDB implementation_intentions>>
        +ObjectId _id
        +String userId
        +ObjectId enrollmentId
        +String behaviorKey
        +String behaviorLabel
        +Int durationMinutes
        +Cue[] cues
        +String intentionStatement
        +String reminderTime  HH:mm or null
        +String status  active|paused|completed|abandoned
    }
    class Cue {
        <<embedded>>
        +String text
        +String source  pre_rated|self_selected
        +ObjectId cueId
    }
    class CuePoolEntry {
        <<MongoDB cue_pools>>
        +ObjectId _id
        +String text
        +String quality  low|high
        +Dimensions dimensions  stability,salience,specificity 1-5
        +String domain
        +String language  en|de|ja
    }
    class DailyBehaviorLog {
        <<MongoDB daily_behavior_logs>>
        +ObjectId _id
        +ObjectId intentionId
        +String userId
        +String date  YYYY-MM-DD
        +Boolean enacted
        +Date loggedAt
    }
    class SrhiResponse {
        <<MongoDB srhi_responses>>
        +ObjectId _id
        +ObjectId intentionId
        +String userId
        +Int weekNumber
        +Date scheduledFor
        +Date submittedAt
        +Map items  srhi_1..srhi_12 : 1-7
        +Double score  mean of items
    }
    ImplementationIntention "1" *-- "1..2" Cue
    Cue "*" ..> "0..1" CuePoolEntry : cueId (if pre_rated)
    ImplementationIntention "*" --> "0..1" Enrollment
    ImplementationIntention "1" --> "0..*" DailyBehaviorLog : unique(intentionId,date)
    ImplementationIntention "1" --> "0..*" SrhiResponse : unique(intentionId,week)
    ImplementationIntention "*" --> "1" User

    %% ===================== Questionnaires & profiles =====================
    class Questionnaire {
        <<MongoDB questionnaires>>
        +ObjectId _id
        +String slug
        +String title
        +Question[] questions
    }
    class FormResponse {
        <<MongoDB form_responses>>
        +ObjectId _id
        +String userId
        +ObjectId questionnaireId
        +Map answers
        +Date submittedAt
        +String habitUuid  post-donation fill only, see HabitDonation
    }
    class Profile {
        <<MongoDB profiles>>
        +String userId
        +Map answers
    }
    class ProfileFieldDefinition {
        <<MongoDB profile_field_definitions>>
        +String key
        +String type
        +String[] options
    }
    Study "1" --> "0..*" Questionnaire : assigns
    Questionnaire "1" --> "0..*" FormResponse
    FormResponse "*" --> "1" User
    Profile "*" --> "1" User
    Profile ..> ProfileFieldDefinition : validated by

    %% ===================== Recommendations =====================
    class Recommendation {
        <<MongoDB recommendations>>
        +ObjectId _id
        +String userId
        +String goal
        +String sessionId
        +Item[] recommendations
        +Date createdAt
    }
    class RecommendationFeedback {
        <<MongoDB recommendation_feedback>>
        +ObjectId _id
        +ObjectId recommendationId
        +String userId
        +String text
    }
    Recommendation "1" --> "0..*" RecommendationFeedback
    Recommendation "*" --> "1" User

    %% ===================== Notifications =====================
    class NotificationCampaign {
        <<MongoDB notification_campaigns>>
        +ObjectId _id
        +ObjectId studyId
        +String createdBy
        +String title  max 65
        +String body  max 240
        +String targetType  individual|group|all_enrolled
        +String[] targetIds
        +Date scheduledFor
        +Date sentAt
        +Int recipientCount
        +String status  draft|scheduled|sent|failed
    }
    NotificationCampaign "*" --> "0..1" Study

    %% ===================== Habit graph (Neo4j) =====================
    class Habit {
        <<Neo4j node>>
        +String uuid
        +String original
        +String language
        +String translationEN
        +String translationDE
        +String studyId
        +Int annotations_like
        +Int annotations_helpful
        +Int annotations_iDoThis
    }
    class Context {
        <<Neo4j node>>
        +String text
        +String dimension  TimeReference|PhysicalSetting|People|InternalState|PriorBehavior|Reasoning
    }
    class BCIOConcept {
        <<Neo4j node>>
        +String name
        +String uri
    }
    class Comment {
        <<Neo4j node>>
        +String id
        +String text
        +String createdAt
        +Boolean flagged
        +Boolean approved
        +String flagReason
    }
    class HabitCommentOwnership {
        <<MongoDB habit_comments>>
        +String commentId
        +String habitId
        +String userId
        +Date createdAt
    }
    Comment "0..*" --> "1" Habit : COMMENT_ON
    HabitCommentOwnership ..> Comment : maps author (GDPR erasure)
    HabitCommentOwnership "*" --> "1" User
    Habit "1" --> "0..*" Context : HAS_CONTEXT
    Context "1" --> "0..*" BCIOConcept : MAPS_TO
    Habit "*" ..> "1" User : donated by (anonymised)

    class HabitDonation {
        <<MongoDB habit_donations>>
        +ObjectId _id
        +String uuid  == Habit.uuid, the join key
        +String userId
        +String studyId
        +String groupId
        +String inputMode  text|speech
        +Boolean isHabit  null until classifier verdict known
        +String transcript  raw STT output, speech only
        +Boolean transcriptEdited
        +Object audioClip  filename, mimeType, sizeBytes, storedAt
        +String questionnaireSlug
        +ObjectId questionnaireResponseId
    }
    HabitDonation "*" --> "1" User
    HabitDonation ..> Habit : uuid (one record per donation<br/>attempt, accepted or rejected)
    HabitDonation ..> FormResponse : questionnaireResponseId<br/>(post-donation questionnaire, if configured)

    %% ===================== Study & Questionnaire graph (Neo4j) =====================
    %% MongoDB (Study, Questionnaire above) is the source of truth; these are its
    %% Neo4j projection — see docs/data-model.md §1.2.
    class StudyGraph["Study"] {
        <<Neo4j node>>
        +String uuid
        +String name
    }
    class QuestionnaireGraph["Questionnaire"] {
        <<Neo4j node>>
        +String slug
        +String title
        +String version
    }
    class QuestionnaireItem {
        <<Neo4j node>>
        +String uid  slug::itemId
        +String questionnaireSlug
        +String itemId
        +String text
        +String type
        +Int position
        +Boolean adhoc
    }
    class QuestionnaireResponse {
        <<Neo4j node>>
        +String responseId  MongoDB form_responses._id
        +Date submittedAt
        +String questionnaireSlug
        +Int occurrence
        +Date scheduledFor
    }
    Study ..> StudyGraph : projected as (uuid = _id)
    Questionnaire ..> QuestionnaireGraph : projected as (slug)
    StudyGraph "1" --> "0..*" QuestionnaireGraph : HAS_QUESTIONNAIRE
    QuestionnaireGraph "1" --> "0..*" QuestionnaireItem : HAS_ITEM
    User "1" --> "0..*" StudyGraph : ENROLLED_IN
    User "1" --> "0..*" QuestionnaireResponse : SUBMITTED
    QuestionnaireResponse "*" --> "1" QuestionnaireGraph : FOR_QUESTIONNAIRE
    QuestionnaireResponse "*" --> "0..*" QuestionnaireItem : HAS_ANSWER (value, rawValue)
