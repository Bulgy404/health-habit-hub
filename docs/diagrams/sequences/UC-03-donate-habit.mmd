%% UC-03 — Donate habit (async BullMQ job: classify → context → BCIO → translate → persist → embed)
%% Optional voice input (stateless transcription) + habit_donations linkage record +
%% optional post-donation questionnaire (extends UC-06).
%% Source: app/routes/habits/habitsCrudRouter.js, app/routes/habits/voiceTranscribeRouter.js,
%% app/services/habitDonationService.js, app/lib/habitQueue.js, API-service/routers/transcribe_audio.py
sequenceDiagram
    autonumber
    actor P as Participant
    participant F as Flutter App
    participant B as Backend (habitsCrudRouter)
    participant Mongo as MongoDB (habit_donations)
    participant Q as Redis (BullMQ habitQueue)
    participant W as Habit donation worker
    participant AI as API-service (FastAPI)
    participant LT as LibreTranslate
    participant N4 as Neo4j

    opt Voice input (admin-enabled: speech-only or participant's choice)
        P->>F: Record spoken habit sentence
        F->>B: POST /api/v1/habits/share/transcribe (multipart audio)
        B->>AI: POST /llm/transcribe-audio
        AI-->>B: {transcript}
        B-->>F: {transcript}
        Note over F: Stateless — nothing persisted yet.<br/>Participant reviews/edits the transcript<br/>before it becomes `sentence` below.
        F-->>P: Editable transcript
    end

    P->>F: Confirm habit sentence
    F->>B: POST /api/v1/habits/donate<br/>{sentence, language, inputMode, transcript?, transcriptEdited?}
    B->>B: Verify JWT (requireRole: user)
    B->>B: resolveHabitConfig() — reject 403<br/>if inputMode:"speech" isn't permitted for this study/group
    B->>Mongo: createDonationRecord({uuid, userId, inputMode, transcript,<br/>questionnaireSlug: resolved donationQuestionnaireSlug})
    B->>Q: enqueueHabitDonation({uuid, sentence, language, studyId, ...})
    Q-->>B: jobId
    B-->>F: 202 {jobId, uuid, status: "pending", postDonationQuestionnaireSlug}

    alt postDonationQuestionnaireSlug present
        F-->>P: Skip the "share another habit" success screen —<br/>navigate straight to /questionnaire/:slug?habitUuid=:uuid
        Note over F,B: Decided immediately from the 202 response, before<br/>classification (below) has even run — the questionnaire is<br/>offered regardless of the eventual accept/reject outcome.<br/>Reuses UC-06 unmodified. POST /questionnaire-responses<br/>with habitUuid bypasses the scheduled-window gate and<br/>links the response back to this habit_donations record.
    else no post-donation questionnaire configured
        F-->>P: Show "share another habit" success screen
    end

    F->>F: Poll GET /api/v1/habits/jobs/:jobId (independent of the branch above)

    Note over Q,W: Runs off-request in the worker, not on the HTTP thread
    Q->>W: dequeue job
    W->>AI: POST /llm/classify-habit {sentence}
    AI-->>W: {is_habit, confidence}
    alt not a habit
        W->>N4: CREATE (:RejectedHabit {is_habit:false, confidence, userID})
        W-->>Q: job result: rejected
    else is a habit
        W->>AI: POST /llm/classify-context {sentence}
        AI-->>W: contexts [{text, dimension}]
        W->>AI: POST /llm/map-bcio {contexts}
        AI-->>W: mappings [{text, bcio_concept, bcio_uri}]
        par fan out to every non-source app language (en/de/ja/fr/nl)
            W->>LT: POST /translate {q, source, target}
            LT-->>W: translation
        end
        W->>N4: CREATE (:Habit {translations, studyId}) MERGE (:Context)-[:HAS_CONTEXT]-<br/>MERGE (:BCIOConcept)-[:MAPS_TO]-
        N4-->>W: nodes created
        W->>AI: POST /llm/embed-batch {uuid, sentence, contexts, mappings}
        AI-->>W: embeddings stored (vector index)
        W-->>Q: job result: {is_habit: true, uuid}
    end
    W->>Mongo: markDonationOutcome({uuid, isHabit}) [best-effort]

    F->>B: GET /api/v1/habits/jobs/:jobId
    B->>Q: getJobStatus(jobId)
    Q-->>B: {status: "completed", result}
    B-->>F: 200 {is_habit, uuid?, message}
    F-->>P: "Habit donated" or "Not recognised as a habit"

    opt inputMode was "speech"
        F->>B: POST /api/v1/habits/donations/:uuid/audio (multipart audio)
        B->>Mongo: set habit_donations.audioClip [best-effort — never blocks the donation]
    end
