%% UC-18 — Manage participants
%% Devices/sessions merged into this page: admin/src/app/(admin)/participants/page.tsx
sequenceDiagram
    autonumber
    actor R as Researcher / Admin
    participant AP as Admin Panel
    participant B as Backend (adminParticipantService)
    participant M as MongoDB
    participant KC as Keycloak (Admin API)

    R->>AP: Open Participants page
    AP->>B: GET /api/v1/admin/participants
    B->>M: find(participants, {deletedAt: null}) + enrollment join
    M-->>B: participant list + progress
    B-->>AP: participants
    AP->>B: GET /api/v1/admin/sessions (paginated)
    B->>KC: list active sessions
    KC-->>B: sessions
    B-->>AP: sessions
    AP->>AP: group sessions by participantId (== Keycloak sub == Participant.id)<br/>render as a "Devices" column — a participant may have several
    R->>AP: Create / edit / soft-delete participant / revoke device access
    alt create
        AP->>B: POST /api/v1/admin/participants
        B->>KC: Create Keycloak user (role user, group attribute)
        B->>M: insert(participants)
    else soft-delete
        AP->>B: DELETE /api/v1/admin/participants/:id
        B->>M: $set {deletedAt: now}
        B->>KC: Disable Keycloak user
    else revoke access (one participant, possibly several devices)
        loop each session belonging to this participant
            AP->>B: DELETE /api/v1/admin/sessions/:id
            B->>KC: revoke session
        end
    end
    B-->>AP: 200 / 201

    Note over AP: Sessions with no matching participant record<br/>(orphaned Keycloak sessions) aren't shown here —<br/>see the standalone Devices page instead
