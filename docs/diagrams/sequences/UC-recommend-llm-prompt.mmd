%% M3 Recommendation Pipeline — single-LLM-call architecture
%%
%% LLM-1 (extract_habits selection) is replaced by GDS FastRP re-ranking.
%% LLM-2 (extract_profile formatting) is replaced by build_profile() (deterministic).
%% One LLM call writes recommendations with selected_habit_uuids for explainability.
%%
flowchart TD

    %% ── Data sources ─────────────────────────────────────────────────────────
    GOAL(["goal  ·  user_id  ·  session_id"])

    subgraph NEO4J_PERSONAL["Neo4j — personal habits"]
        NP["`MATCH (h:Habit {userID: $user_id, is_habit: true})
        cosine-rank vs. goal embedding
        → top USER_HABITS_LIMIT`"]
    end

    subgraph NEO4J_COMMUNITY["Neo4j — community habits (3-index fan-out)"]
        NC["`habit_embedding_idx · context_embedding_idx · bcio_embedding_idx
        merge by max(score) → top COMMUNITY_HABITS_LIMIT`"]
    end

    subgraph GDS_RERANK["GDS FastRP re-ranking  *(replaces LLM-1 selection)*"]
        direction TB
        GR1["`Fetch user habits' fastrp_embedding vectors from Neo4j`"]
        GR2["`Compute user centroid = mean(user_habit_embeddings)`"]
        GR3["`Score each community habit:
        0.5 × cosine(goal_emb, sentence_emb)
        0.3 × cosine(user_centroid, fastrp_emb)
        0.2 × log-normalised likes`"]
        GR1 --> GR2 --> GR3
    end

    subgraph MONGO_ANNOT["MongoDB + Neo4j — bookmarked habits"]
        MA["`habit_annotations.find(
          {userId, type: {$in: ['helpful','iDoThis','like']}})
        → fetch Habit nodes from Neo4j by UUID`"]
    end

    subgraph BACKEND_QA["Node.js backend  (X-Service-Auth-Token)"]
        QA1["`GET /questionnaire-responses/service/{userId}
        → enrollment → studyId → questionnaire slugs → latest responses
        → {[slug]: responseOrNull}  *(study-configurable)*`"]
        QA2["GET /user-profile/service/{userId}"]
    end

    subgraph PROFILE_BUILD["build_profile()  *(replaces LLM-2)*"]
        direction TB
        PB1["`Extract demographic labels from profile fields`"]
        PB2["`Format each questionnaire response generically
        (known slugs get human-readable labels;
        unknown slugs formatted with raw questionId keys)`"]
        PB3["`Assemble profile_summary, profile_detailed, rag_query`"]
        PB1 & PB2 --> PB3
    end

    subgraph NEO4J_BCIO["Neo4j — BCIO concepts per habit"]
        BC["`MATCH (h)-[:HAS_CONTEXT]->(c)-[:MAPS_TO]->(b:BCIOConcept)
        WHERE h.uuid IN top_habit_uuids
        RETURN h.uuid, collect(DISTINCT b.label)`"]
    end

    subgraph LIGHTRAG["LightRAG"]
        LR["`POST /query
        {query: rag_query, mode: 'hybrid', only_need_context: true}`"]
    end

    subgraph MONGO_FB["MongoDB — prior feedback"]
        FB["`recommendation_feedback.find(
          {userId, goal}).sort({created_at:-1}).limit(10)`"]
    end

    %% ── Wiring ───────────────────────────────────────────────────────────────
    GOAL --> NEO4J_PERSONAL & NEO4J_COMMUNITY & MONGO_ANNOT & BACKEND_QA & MONGO_FB
    NEO4J_PERSONAL --> GDS_RERANK
    NEO4J_COMMUNITY --> GDS_RERANK
    BACKEND_QA --> PROFILE_BUILD
    GOAL --> PROFILE_BUILD

    GDS_RERANK -->|ranked community habits| NEO4J_BCIO
    NEO4J_PERSONAL -->|personal habit UUIDs| NEO4J_BCIO
    PROFILE_BUILD -->|rag_query| LIGHTRAG

    %% ── Final prompt assembly ─────────────────────────────────────────────────
    subgraph FINAL["Single LLM call — recommend.txt  (temp 0.2)"]
        direction TB

        F1["`**[1] USER GOAL**
        {goal}  ← from request`"]

        F2["`**[2] USER HEALTH PROFILE**
        {profile_summary}   ← build_profile()
        {profile_detailed}  ← build_profile()`"]

        F3["`**[3] USER'S OWN HABITS**
        {personal_habits_json}  ← cosine-ranked personal habits
            [{uuid, sentence, context, bcio_concepts, likes}]`"]

        F4["`**[4] BOOKMARKED HABITS**
        {annotated_habits_json}  ← MongoDB → Neo4j
            [{uuid, sentence, context, bcio_concepts}]`"]

        F5["`**[5] COMMUNITY HABITS**
        {community_habits_json}  ← GDS FastRP re-ranked
            [{uuid, sentence, context, bcio_concepts, likes}]`"]

        F6["`**[6] ACADEMIC SOURCES**
        {sources_json}  ← LightRAG hybrid retrieval`"]

        F7["`**[7] PRIOR FEEDBACK**
        {prior_feedback}  ← MongoDB comments`"]

        F1 --> F2 --> F3 --> F4 --> F5 --> F6 --> F7
    end

    GDS_RERANK --> F5
    NEO4J_PERSONAL --> F3
    NEO4J_BCIO -->|bcio_concepts| F3
    NEO4J_BCIO -->|bcio_concepts| F4
    NEO4J_BCIO -->|bcio_concepts| F5
    PROFILE_BUILD --> F2
    MONGO_ANNOT --> F4
    LIGHTRAG --> F6
    MONGO_FB --> F7
    GOAL --> F1

    subgraph OUTPUT["LLM Output"]
        OUT["`{recommendations: [
          {
            title,
            body,
            rationale,            ← may cite BCIOConcept names
            selected_habit_uuids  ← explainability: which habits informed this
          },
          ...  (3–5 items)
        ]}`"]
    end

    F7 --> OUTPUT

    %% ── Stored / cached ──────────────────────────────────────────────────────
    PERSIST["`MongoDB recommendations.insertOne(...)
    Redis SETEX recommend:{sha256(user_id‖goal)} 86400`"]
    OUTPUT --> PERSIST

    %% ── Styles ───────────────────────────────────────────────────────────────
    style GDS_RERANK fill:#fff3e0,stroke:#e65100
    style PROFILE_BUILD fill:#e8f8e8,stroke:#5a9a4a
    style FINAL fill:#fff8e8,stroke:#c9a020
    style MONGO_ANNOT fill:#f8eef8,stroke:#9a4ab0
    style NEO4J_PERSONAL fill:#d8edf8,stroke:#4a90d9
    style NEO4J_COMMUNITY fill:#c8e4f4,stroke:#4a90d9
    style NEO4J_BCIO fill:#d0e8ff,stroke:#4a90d9
    style OUTPUT fill:#fce8e8,stroke:#d94a4a
