%% UC-37 — View, trigger, and restore backups from the admin panel
%% Source: admin/src/app/(admin)/backups/page.tsx, app/routes/admin/backupsRouter.js,
%% app/services/backupService.js, backup-service/api/*.js, backup-service/backup.sh,
%% backup-service/restore.sh
%% Per-component breakdown (mongo, neo4j, lightrag, audio-recordings, keycloak) is
%% intentionally abstracted below as "per-component ✓/✗" — see backup.sh/restore.sh
%% for the individual steps, including the audio-recordings tar step.
sequenceDiagram
    autonumber
    actor A as Admin
    participant AP as Admin Panel (Backups page)
    participant B as Backend (backupsRouter, admin-only)
    participant M as MongoDB (backup_audit_log, restore_confirmation_tokens)
    participant BA as backup-api (inside hhh-backup, internal network only)

    A->>AP: Open Backups page
    AP->>B: GET /admin/backups/status
    B->>BA: GET /status (X-Service-Auth-Token)
    BA-->>B: last backup + history, read from *.manifest.json
    B-->>AP: status (per-component ✓/✗, size, age, trigger reason)

    A->>AP: Click "Trigger backup now"
    AP->>B: POST /admin/backups/trigger
    B->>M: insert backup_audit_log {action: trigger, result: requested}
    B->>BA: POST /trigger
    BA-->>B: 202 {jobId} (409 if a job is already running)
    B->>M: insert backup_audit_log {result: succeeded|failed}
    B-->>AP: 202
    loop every 3s while a job is in progress
        AP->>B: GET /admin/backups/jobs/current
        B->>BA: GET /jobs/current
        BA-->>AP: phase (running → done/failed)
    end

    A->>AP: Click "Restore" on a backup row, type the exact filename to confirm
    AP->>B: POST /admin/backups/:filename/restore-token
    B->>M: insert restore_confirmation_tokens {token, filename, byUserId, expiresAt: +2min}
    B-->>AP: token
    AP->>B: POST /admin/backups/:filename/restore {confirmFilename, restoreToken, acknowledgeWarnings?, restoreKeycloak?}
    B->>B: confirmFilename must equal :filename (re-checked server-side)
    B->>M: consume + delete the matching, unexpired token (single-use)
    alt token missing/expired/wrong user
        B-->>AP: 400 — request a new token
    end
    B->>M: insert backup_audit_log {action: restore, result: requested}
    B->>BA: POST /restore {filename, confirmFilename, acknowledgeWarnings, restoreKeycloak}
    BA->>BA: reject with 409 + warnings if the target's manifest shows a failed component and acknowledgeWarnings isn't set
    BA-->>B: 202 {jobId}
    B->>B: set admin_settings.maintenanceMode = true (rest of the API returns 503 until this clears)
    Note over BA: One background job — (1) pre_restore_safety backup, abort if it fails, (2) pipe "YES" into restore.sh, (3) parse ✓/ERROR per component, never trust exit code alone
    B->>BA: poll GET /jobs/current until terminal
    B->>M: insert backup_audit_log {action: restore, result: succeeded|failed, detail}
    B->>B: clear admin_settings.maintenanceMode (also force-cleared after a 30min safety deadline)
