{
  "info": {
    "name": "Health Habit Hub API",
    "description": "Complete REST API collection for the Health Habit Hub platform. Import this into Postman, set the `baseUrl` and `token` variables, then run any request.\n\nFor the Python Recommender Service spec, see: API-service/openapi.yaml",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string",
      "description": "Base URL for the HHH API"
    },
    {
      "key": "token",
      "value": "<your-keycloak-jwt>",
      "type": "string",
      "description": "Keycloak JWT bearer token. Obtain from: POST /realms/hhh/protocol/openid-connect/token"
    },
    {
      "key": "participantId",
      "value": "a1b2c3d4-1234-5678-abcd-ef0123456789",
      "type": "string",
      "description": "Example participant userId (UUID)"
    },
    {
      "key": "surveyId",
      "value": "survey-uuid-001",
      "type": "string",
      "description": "Example survey UUID"
    },
    {
      "key": "habitId",
      "value": "habit-001",
      "type": "string",
      "description": "Example habit node ID"
    },
    {
      "key": "sessionId",
      "value": "session-abc123",
      "type": "string",
      "description": "Example Keycloak session ID"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check health of all downstream services (neo4j, mongo, fuseki, keycloak, recommender). No authentication required."
          },
          "response": [
            {
              "name": "200 – All services healthy",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"status\":\"ok\",\"services\":{\"neo4j\":{\"status\":\"ok\",\"latencyMs\":8},\"mongo\":{\"status\":\"ok\",\"latencyMs\":5},\"fuseki\":{\"status\":\"ok\",\"latencyMs\":22},\"keycloak\":{\"status\":\"ok\",\"latencyMs\":30},\"recommender\":{\"status\":\"ok\",\"latencyMs\":15}}}"
            }
          ]
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "GET /docs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs",
              "host": ["{{baseUrl}}"],
              "path": ["docs"]
            },
            "description": "Open Swagger UI in browser for interactive API documentation."
          },
          "response": []
        },
        {
          "name": "GET /docs/openapi.json",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/openapi.json",
              "host": ["{{baseUrl}}"],
              "path": ["docs", "openapi.json"]
            },
            "description": "Raw OpenAPI 3.1 spec as JSON."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "GET /profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            },
            "description": "Get the authenticated user's profile. Returns 404 if no profile has been created yet."
          },
          "response": [
            {
              "name": "200 – Profile found",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"userId\":\"a1b2c3d4-1234-5678-abcd-ef0123456789\",\"answers\":{\"age\":30,\"goal\":\"exercise more\"},\"completedAt\":\"2026-03-15T10:00:00.000Z\",\"updatedAt\":\"2026-03-15T10:00:00.000Z\"}"
            },
            {
              "name": "401 – Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"error\":\"Unauthorized\"}"
            },
            {
              "name": "404 – Profile not found",
              "status": "Not Found",
              "code": 404,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"error\":\"Profile not found\"}"
            }
          ]
        },
        {
          "name": "POST /profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"answers\":{\"age\":30,\"goal\":\"exercise more\"},\"completedAt\":\"2026-03-15T10:00:00.000Z\"}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            },
            "description": "Create or update the authenticated user's profile."
          },
          "response": [
            {
              "name": "200 – Profile upserted",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"userId\":\"a1b2c3d4-1234-5678-abcd-ef0123456789\",\"answers\":{\"age\":30,\"goal\":\"exercise more\"},\"completedAt\":\"2026-03-15T10:00:00.000Z\",\"updatedAt\":\"2026-03-15T10:00:00.000Z\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Surveys",
      "item": [
        {
          "name": "GET /surveys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys",
              "host": ["{{baseUrl}}"],
              "path": ["surveys"]
            },
            "description": "List surveys. Participants see only published surveys for their group; admins/researchers see all."
          },
          "response": [
            {
              "name": "200 – Surveys list",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "[{\"id\":\"survey-uuid-001\",\"title\":\"Baseline Questionnaire\",\"type\":\"questionnaire\",\"status\":\"published\",\"assignedGroups\":[\"G1\",\"G2\"]}]"
            }
          ]
        },
        {
          "name": "GET /surveys/:id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "{{surveyId}}"]
            },
            "description": "Get a single survey by ID including the SurveyJS JSON schema."
          },
          "response": [
            {
              "name": "200 – Survey detail",
              "status": "OK",
              "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"id\":\"survey-uuid-001\",\"title\":\"Baseline Questionnaire\",\"type\":\"questionnaire\",\"status\":\"published\",\"assignedGroups\":[\"G1\",\"G2\"],\"jsonSchema\":{\"pages\":[]}}"
            },
            {
              "name": "404 – Survey not found",
              "status": "Not Found",
              "code": 404,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"error\":\"Survey not found\"}"
            }
          ]
        },
        {
          "name": "POST /surveys/:id/results",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"answers\":{\"q1\":\"yes\",\"q2\":42}}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/results",
              "host": ["{{baseUrl}}"],
              "path": ["surveys", "{{surveyId}}", "results"]
            },
            "description": "Submit survey answers for the authenticated participant."
          },
          "response": [
            {
              "name": "201 – Survey response recorded",
              "status": "Created",
              "code": 201,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"ok\":true,\"surveyId\":\"survey-uuid-001\",\"completedAt\":\"2026-03-15T10:00:00.000Z\"}"
            }
          ]
        }
      ]
    },
