FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, not
# read at container-runtime — setting them in docker-compose's `environment:`
# has no effect on an already-built image. They must come in as build ARGs
# and be promoted to ENV here so `npm run build` (next build) can see them.
ARG NEXT_PUBLIC_NEXTAUTH_URL
ARG NEXT_PUBLIC_KEYCLOAK_BROWSER_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_DOCS_URL
ARG NEXT_PUBLIC_GRAFANA_URL
ARG NEXT_PUBLIC_PROMETHEUS_URL
ARG NEXT_PUBLIC_NEO4J_BROWSER_URL
ARG NEXT_PUBLIC_MONGO_EXPRESS_URL
ARG NEXT_PUBLIC_BULL_BOARD_URL
ARG NEXT_PUBLIC_REDIS_INSIGHT_URL
ARG NEXT_PUBLIC_LIGHTRAG_WEBUI_URL
ENV NEXT_PUBLIC_NEXTAUTH_URL=${NEXT_PUBLIC_NEXTAUTH_URL}
ENV NEXT_PUBLIC_KEYCLOAK_BROWSER_URL=${NEXT_PUBLIC_KEYCLOAK_BROWSER_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_DOCS_URL=${NEXT_PUBLIC_API_DOCS_URL}
ENV NEXT_PUBLIC_GRAFANA_URL=${NEXT_PUBLIC_GRAFANA_URL}
ENV NEXT_PUBLIC_PROMETHEUS_URL=${NEXT_PUBLIC_PROMETHEUS_URL}
ENV NEXT_PUBLIC_NEO4J_BROWSER_URL=${NEXT_PUBLIC_NEO4J_BROWSER_URL}
ENV NEXT_PUBLIC_MONGO_EXPRESS_URL=${NEXT_PUBLIC_MONGO_EXPRESS_URL}
ENV NEXT_PUBLIC_BULL_BOARD_URL=${NEXT_PUBLIC_BULL_BOARD_URL}
ENV NEXT_PUBLIC_REDIS_INSIGHT_URL=${NEXT_PUBLIC_REDIS_INSIGHT_URL}
ENV NEXT_PUBLIC_LIGHTRAG_WEBUI_URL=${NEXT_PUBLIC_LIGHTRAG_WEBUI_URL}

RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
USER nextjs
EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
