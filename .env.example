# ─────────────────────────────────────────────
# Health Habit Hub — Environment Variable Template
#
# Copy this file to .env (development) or supply values via Portainer (production).
# Every CHANGE_THIS_* placeholder must be replaced before starting services.
# Never commit real secrets to Git.
# ─────────────────────────────────────────────

# ══ Domain / Public URLs ══════════════════════
# DOMAIN is the single public hostname this whole stack is served from in
# production. Every service is a path on it behind Traefik: the app at
# https://$DOMAIN, admin portal at /admin, Keycloak at /auth, Grafana at
# /grafana, mongo-express at /mongo, LibreTranslate at /translate, LightRAG
# WebUI at /lightrag, Prometheus at /prometheus, RedisInsight at /redisinsight,
# Neo4j Browser at /neo4j. Changing DOMAIN re-routes the entire deployment —
# update DNS + TLS before switching it. No extra DNS records are needed for
# any of the above — they all ride on the one $DOMAIN record and its cert.
DOMAIN=CHANGE_THIS_DOMAIN      # e.g. habit.wiwi.tu-dresden.de
# Neo4j Browser's query console needs a second channel besides the page
# itself: a bolt-over-websocket connection, which (unlike everything else
# above) can't be routed by URL path — the Bolt protocol only knows host:port,
# no path. So it gets its own port on the SAME $DOMAIN instead of a path or a
# new subdomain (see docker-compose.yml proxy + neo4j service comments for
# why). Open this port in your firewall/cloud security group alongside 80/443
# — nothing else to configure, it reuses $DOMAIN's existing TLS cert.
NEO4J_BOLT_PORT=7687
# Contact address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=CHANGE_THIS_ACME_EMAIL
# ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory  # default: Let's Encrypt
# Local-dev-only alternative to DOMAIN: per-service subdomains under this
# suffix (app.localhost, admin.localhost, ...) instead of path-based routing.
# Ignored once DOMAIN-based Traefik rules are active in production.
PATH_SUFFIX=localhost

# ══ Traefik / Reverse Proxy ═══════════════════
PROXY_PATH=proxy
TRAEFIK_HOST_PORT80=80
# 8888, not 8080 — Keycloak also publishes 8080 in docker-compose.local.yml,
# so 8080 here would fail to bind at container start.
TRAEFIK_HOST_PORT8080=8888
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ══ Node.js Backend (app) ═════════════════════
APP_PATH=app
APP_BASE_PATH=/                # Mount prefix for the app (usually /)
# Port used when running scripts (e.g. scripts/seed-habits.py) against the
# app directly on localhost instead of through Traefik.
APP_LOCAL_PORT=3000
NODE_ENV=development
# Comma-separated origins allowed by the API CORS policy (admin/researcher portals)
ALLOWED_ORIGINS=http://admin.localhost,http://researcher.localhost,http://localhost:3001
# Store + reveal participant recovery phrases in the admin portal. These are
# effectively account secrets — keep this FALSE (or unset) in production.
# Set to "true" only for local test/verification.
EXPOSE_RECOVERY_PHRASES=false
# Enable dev "test tools" (e.g. the participant fast-forward control that shifts
# a participant's timeline to exercise time-based flows). Keep FALSE in
# production; set "true" only for local testing.
ENABLE_TEST_TOOLS=false
# Admin "insights" cache TTL (seconds). Cross-DB aggregations are cached in
# Redis for this long before recompute (admins can force-refresh in the UI).
INSIGHTS_CACHE_TTL_SECONDS=300
# Fixed recovery phrase for the seeded QA test participant (`make seed-user`,
# scripts/seed-test-user.js). Optional — the script falls back to a built-in
# default phrase if unset. Local test fixture only, not a production secret.
# TEST_USER_PHRASE=

# ══ Admin Portal (Next.js) — external tool links ══
# URLs the admin "System & Links" page and analytics "raw data" links point to.
# Defaults below suit a local docker stack; both compose files already set
# NEXT_PUBLIC_GRAFANA_URL correctly per environment — only override here if needed.
# NEXT_PUBLIC_GRAFANA_URL=http://grafana.localhost
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_NEO4J_BROWSER_URL=http://localhost:7474
NEXT_PUBLIC_MONGO_EXPRESS_URL=http://localhost:8081
NEXT_PUBLIC_LIGHTRAG_WEBUI_URL=http://localhost:9622
NEXT_PUBLIC_REDIS_INSIGHT_URL=http://localhost:5540
# NEXT_PUBLIC_API_DOCS_URL=  # defaults to <api-host>/api-docs
# Session-signing secret for the admin portal's NextAuth login.
# docker-compose.local.yml falls back to an insecure dev default if unset;
# docker-compose.yml (production) has NO fallback — required in production.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET

# ══ Keycloak Identity Provider ════════════════
KEYCLOAK_ADMIN=admin                                    # Keycloak master-realm admin username
KEYCLOAK_ADMIN_PASSWORD=CHANGE_THIS_KEYCLOAK_PASSWORD  # Keycloak master-realm admin password
HHH_ADMIN_USER=admin                                    # Admin portal login username (HHH realm); password = KEYCLOAK_ADMIN_PASSWORD
# Keycloak PostgreSQL database credentials (used by the keycloak-db Postgres service in docker-compose.yml)
KC_DB_USERNAME=keycloak                                 # PostgreSQL user for Keycloak DB
KC_DB_PASSWORD=CHANGE_THIS_KC_DB_PASSWORD              # PostgreSQL password for Keycloak DB
# Internal JWKS URL used by the backend for JWT verification
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/hhh/protocol/openid-connect/certs
# JWT issuer claim expected by the backend middleware
KEYCLOAK_JWT_ISSUER=http://keycloak:8080/realms/hhh
# JWT audience claim expected by the backend middleware
KEYCLOAK_JWT_AUDIENCE=account
# Keycloak base URL (used by onboard route to call admin REST API)
KEYCLOAK_URL=http://keycloak:8080
# Realm name
KEYCLOAK_REALM=hhh
# Public Flutter client — PKCE only; direct access grants (ROPC) are disabled
# on this client so a stolen client_id can't be used to brute-force logins.
KEYCLOAK_CLIENT_ID=hhh-flutter
# Backend confidential client (used by admin routes for service-account calls)
KEYCLOAK_ADMIN_CLIENT_ID=hhh-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_BACKEND_SECRET
# Admin web client (used by NextAuth in the admin panel)
KEYCLOAK_ADMIN_UI_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_ADMIN_UI_SECRET
# Confidential client used ONLY server-side (onboarding, credential rotation,
# passphrase-based account restore) to mint token pairs on a participant's
# behalf via the OAuth password grant. Never exposed to the mobile app.
KEYCLOAK_ROPC_CLIENT_ID=hhh-ropc
KEYCLOAK_ROPC_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_ROPC_SECRET

# ══ LibreTranslate ════════════════════════════
TRANSLATE_HOST=translate
TRANSLATE_PORT=5000
TRANSLATE_PATH=/translate
# Alternatively set the full URL directly:
# LIBRE_TRANSLATE_URL=http://translate:5000/translate
LT_HOST=${TRANSLATE_HOST}
LT_PORT=${TRANSLATE_PORT}
LT_LOAD_ONLY=de,en,ja,fr,nl    # Comma-separated ISO 639-1 codes; controls which language packs are loaded
LT_REQ_LIMIT=0                 # Max characters per request (0 = unlimited)
LT_DEBUG=
LT_DISABLE_WEB_UI=
# LT_UPDATE_MODELS=            # Uncomment to force model update on startup
# LT_METRICS=                  # Uncomment to enable Prometheus metrics

# ══ MongoDB ════════════════════════════════════
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_THIS_MONGO_PASSWORD
MONGO_DB=surveyjs
MONGO_AUTH_SOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=5000

# ── Internal-tool access = Keycloak SSO (no htpasswd hashes) ─────────────────
# Prometheus (/prometheus), Bull Board (/queues), RedisInsight (/redisinsight),
# Neo4j Browser UI (/neo4j) and mongo-express (/mongo) are gated by oauth2-proxy
# against Keycloak — you log in with your Keycloak account and only accounts
# holding the realm `admin` role are allowed (study participants with `user` are
# denied). mongo-express's own basic auth is disabled (ME_CONFIG_BASICAUTH_ENABLED
# =false in compose), so there are no MONGO_EXPRESS_* credentials anymore.
#
# OAUTH2_PROXY_CLIENT_SECRET must match the `oauth2-proxy` Keycloak client;
# keycloak-init injects it into Keycloak (same pattern as GRAFANA_CLIENT_SECRET).
# OAUTH2_PROXY_COOKIE_SECRET signs the SSO session cookie — 32 bytes.
#   Generate the cookie secret: openssl rand -base64 24
#   (MUST be 16/24/32 chars — oauth2-proxy rejects the 44-char `rand -base64 32`.)
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_THIS_OAUTH2_PROXY_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_THIS_32_CHAR_RANDOM_STRING

# LightRAG is not on the SSO (no OIDC support) — it uses its own login instead,
# which also closes its Guest-access hole. Username is `admin`; set a plaintext
# password and a random JWT signing secret (openssl rand -hex 32).
LIGHTRAG_AUTH_PASSWORD=CHANGE_THIS_LIGHTRAG_PASSWORD
LIGHTRAG_TOKEN_SECRET=CHANGE_THIS_LIGHTRAG_TOKEN_SECRET

# ══ Neo4j Graph Database ══════════════════════
# Graph storage backend for habit donations: 'fuseki' or 'neo4j'
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_NEO4J_PASSWORD

# ══ LightRAG Knowledge Base ═══════════════════
LIGHTRAG_URL=http://lightrag:9621          # URL used by API-service and knowledge-mcp to reach LightRAG
LIGHTRAG_API_KEY=dev-lightrag-secret       # Bearer token for LightRAG REST API auth (change in production)
LIGHTRAG_HOST_PORT=9622                    # Host port for LightRAG graph visualization UI

# ══ Python Recommender / API-service ═════════
# Base URL of the Python FastAPI service (habit classification, BCIO mapping, LLM refinement)
API_SERVICE_URL=http://recommender:8000
API_SERVICE_SECRET=CHANGE_THIS_API_SERVICE_SECRET
RECOMMENDER_URL=http://recommender:8000
# Port used when running scripts (e.g. scripts/seed-habits.py) against the
# recommender directly on localhost instead of through Traefik.
RECOMMENDER_LOCAL_PORT=8001
# Where the app container writes recorded habit-donation voice clips (see
# audio-recordings-data volume in docker-compose.yml). Rarely needs changing.
AUDIO_STORAGE_DIR=/data/audio-recordings

# Redis cache used by the API-service for LLM response caching
# REDIS_PASSWORD must match the --requirepass value in docker-compose.yml
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Internal service-to-service secret (used by /api/v1/internal routes)
INTERNAL_API_SECRET=CHANGE_THIS_INTERNAL_SECRET

# ══ LLM (OpenAI-compatible, used by API-service) ═════════════════════════════
LLM_API_KEY=CHANGE_THIS_API_KEY            # Required for habit classification, context extraction, recommendations
LLM_MODEL=alias-ha                         # e.g. alias-ha, alias-huge, alias-reasoning — a SCADS.AI model alias, not a real OpenAI model name (gpt-4o-mini etc. are not served by llm.scads.ai)
# Single point of control: model to switch to when a primary model
# (LLM_MODEL / LIGHTRAG_LLM_MODEL / LLM_RECOMMEND_MODEL) is down.
# API-service (llm_client.py): checked on every call via a circuit
# breaker — a failure marks the model down for LLM_FALLBACK_COOLDOWN_S,
# during which calls go straight to the fallback; the next call after
# that retries the primary automatically. Fully self-healing, no restart.
# lightrag container (lightrag/entrypoint.sh): the model choice is a
# process-startup argument, so it's re-probed every
# LLM_HEALTH_CHECK_INTERVAL_S and lightrag-server is restarted in place
# (on either model) when the health state flips.
# Must differ from LLM_MODEL — chat_complete() treats an identical
# fallback as "no fallback configured" and skips the retry entirely.
LLM_FALLBACK_MODEL=alias-reasoning
LLM_FALLBACK_COOLDOWN_S=300                # API-service: seconds a failed model is skipped before being retried
LLM_HEALTH_CHECK_INTERVAL_S=120            # lightrag container: seconds between primary-model health re-probes
LLM_TEMPERATURE=0.2                        # 0.0 = deterministic, 1.0 = creative
# LLM_API_BASE=                            # Optional: OpenAI-compatible base URL (e.g. https://llm.scads.ai/v1)
# Model used only for the final habit-recommendation call (falls back to LLM_MODEL if unset)
# LLM_RECOMMEND_MODEL=
# Speed knobs for the recommendation call:
# Cap on the LightRAG context pasted into the prompt, in characters (0 = unlimited).
# The tail of that blob is low-relevance filler; ~30000 chars keeps quality while cutting latency.
# RECOMMEND_MAX_CONTEXT_CHARS=30000
# Hard cap on the completion length in tokens (0 = model default).
# LLM_RECOMMEND_MAX_TOKENS=0
# LIGHTRAG_LLM_MODEL=                      # Model the lightrag container itself uses (falls back to LLM_MODEL if unset)
LLM_STT_MODEL=alias-stt                    # Speech-to-text alias for habit-donation voice input (openai/whisper-large-v3-turbo on SCADS.AI) — reuses LLM_API_KEY/LLM_API_BASE, no separate credential

# ══ Embedding (BCIO ontology mapping) ═════════════════════════════════════════
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B    # Embedding model served at EMBEDDING_API_BASE
# EMBEDDING_DIM=                           # Optional: embedding vector size, if the model needs it declared explicitly
EMBEDDING_API_BASE=https://llm.scads.ai/v1 # Falls back to LLM_API_BASE if unset
EMBEDDING_API_KEY=CHANGE_THIS_API_KEY      # Falls back to LLM_API_KEY if unset
EMBEDDING_CHUNK_SIZE=200                   # Concepts per embedding batch (tune for provider limits)
BCIO_MIN_CONFIDENCE=0.6                    # Minimum cosine similarity to store a BCIO mapping (0.0-1.0)

# ══ Mail (generic SMTP) ════════════════════════
# Used to send critical-alert emails (backup failures, LLM outages, BullMQ
# job failures, service-reachability, 5xx spikes — see docs/runbook.md) to
# ALERT_EMAIL below. Works with any SMTP relay/provider — no vendor lock-in.
SMTP_HOST=CHANGE_THIS_SMTP_HOST        # e.g. smtp.your-provider.example
SMTP_PORT=587                          # 587 = STARTTLS (default), 465 = implicit TLS
SMTP_USER=CHANGE_THIS_SMTP_USER
SMTP_PASS=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM=noreply@example.com          # Accepts "Name <address>" form
SMTP_STARTTLS=true                     # Set false only if SMTP_PORT=465 (implicit TLS)

# ══ Firebase Cloud Messaging (Push Notifications, backend) ═══
# JSON string of the Firebase service account credentials.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Paste the entire JSON on a single line. If absent, push notifications run in no-op mode.
FIREBASE_SERVICE_ACCOUNT_JSON=  # paste full service-account JSON string here

# ══ Firebase Mobile SDK (Flutter app) ═════════
# API keys for the Flutter mobile/web app.
# Copy mobile/firebase.json.example → mobile/firebase.json and fill these in.
# Pass to flutter at build time: flutter run --dart-define-from-file=mobile/firebase.json
# Find keys in Firebase Console → Project Settings → Your apps.
FIREBASE_ANDROID_API_KEY=CHANGE_THIS_FIREBASE_ANDROID_API_KEY
FIREBASE_IOS_API_KEY=CHANGE_THIS_FIREBASE_IOS_API_KEY

# ══ Critical alerts ════════════════════════════
# Where SMTP-based critical alerts are sent: backup failures, LLM outages
# (API-service), BullMQ job failures and service-reachability/5xx alerts
# (Grafana). Requires the SMTP_* vars above to be set.
ALERT_EMAIL=admin@example.com  # BACKUP_EMAIL is a deprecated alias, still read as a fallback by backup-service/backup.sh
# Optional Slack/Discord/Teams webhook for backup alerts:
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ══ Backup ═════════════════════════════════════
BACKUP_RETENTION_DAYS=14       # How many days of backups to retain; also caps daily automatic (scheduled) backups by count (manual/uploaded backups are unaffected by the count cap)
# Shared secret between hhh-app and the internal backup-api HTTP service
# (backup-service/api/) that powers the admin panel's Backups page. Never
# exposed outside the Docker network — generate with: openssl rand -hex 32
# REQUIRED: the backup container refuses to start without it.
BACKUP_API_SECRET=CHANGE_THIS_BACKUP_API_SECRET
BACKUP_UPLOAD_MAX_MB=2048      # Max size for a backup archive uploaded via the admin UI

# ══ Monitoring (Prometheus / Grafana) ═════════
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
# Grafana <-> Keycloak SSO: must match the "grafana" realm client secret
# (injected into Keycloak by keycloak-init).
GRAFANA_CLIENT_SECRET=CHANGE_THIS_GRAFANA_CLIENT_SECRET
# METRICS_PORT=9091                            # Internal port for Prometheus scraping

# ══ Error Reporting (optional — leave empty to disable) ══════════════════════
# Use a SELF-HOSTED Sentry instance so error metadata stays on TU infrastructure.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ══ Offsite Backup Sync (optional but strongly recommended) ══════════════════
# rclone remote name + path, e.g. "tu-s3:hhh-backups". Requires
# backup-service/rclone/rclone.conf (NOT committed — contains credentials).
OFFSITE_REMOTE=
