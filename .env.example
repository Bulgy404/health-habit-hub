# Health Habit Hub — environment configuration
# Sections match .env.example and the local .env.
# .env contains private credentials and must remain ignored by Git.
# Copy .env.example for a new installation; replace the required CHANGE_THIS_* values.
# Local-only, production-only and optional settings are marked below.
# Commented assignments are inactive; blank optional values disable their integration.
# Values retain their original quoting and ${...} interpolation.

# ══ Local test accounts ══
# Admin portal: HHH_ADMIN_USER + KEYCLOAK_ADMIN_PASSWORD (in the Keycloak section).
# Test researcher: HHH_RESEARCHER_USER + HHH_RESEARCHER_PASSWORD; no admin rights.
# Provisioned by make dev / make seed-researcher. Leave its password empty to skip.
# HHH_RESEARCHER_ID is recorded automatically; do not copy IDs between installations.
# TEST_USER_PHRASE is only for seeded participant accounts.
HHH_ADMIN_USER=admin                                    # Admin portal login username (HHH realm); password = KEYCLOAK_ADMIN_PASSWORD
HHH_RESEARCHER_USER=testresearcher
HHH_RESEARCHER_PASSWORD=
# HHH_RESEARCHER_ID=
# TEST_USER_PHRASE=

# ══ Deployment and routing ══
# Production: DOMAIN is the main host, WEBSITE_DOMAIN the public website host.
# Both use the same proxy. DNS and TLS must match before changing either host.
# ACME_EMAIL receives certificate notices; ACME_CA_SERVER is an optional override.
# Local only: PATH_SUFFIX, PROXY_PATH and TRAEFIK_HOST_PORT*.
# Port 8888 avoids the local Keycloak port 8080. Neo4j Bolt uses a separate port.
DOMAIN=CHANGE_THIS_DOMAIN      # e.g. habit.wiwi.tu-dresden.de
WEBSITE_DOMAIN=CHANGE_THIS_WEBSITE_DOMAIN      # e.g. healthhabithub.de
ACME_EMAIL=CHANGE_THIS_ACME_EMAIL
# ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory  # default: Let's Encrypt
PATH_SUFFIX=localhost
PROXY_PATH=proxy
TRAEFIK_HOST_PORT80=80
TRAEFIK_HOST_PORT8080=8888
DOCKER_SOCKET_PATH=/var/run/docker.sock
NEO4J_BOLT_PORT=7687

# ══ Backend and internal services ══
# Internal Docker addresses differ from localhost addresses used by host-run scripts.
# API_SERVICE_SECRET protects classifier/recommender calls; INTERNAL_API_SECRET
# protects internal platform endpoints. Neither is a researcher login credential.
# AUDIO_STORAGE_DIR must match the recorded-audio volume mount.
NODE_ENV=development
APP_PATH=app
APP_BASE_PATH=/                # Mount prefix for the app (usually /)
APP_LOCAL_PORT=3000
ALLOWED_ORIGINS=http://admin.localhost,http://researcher.localhost,http://localhost:3001
API_SERVICE_URL=http://recommender:8000
RECOMMENDER_URL=http://recommender:8000
RECOMMENDER_LOCAL_PORT=8001
API_SERVICE_SECRET=CHANGE_THIS_API_SERVICE_SECRET
INTERNAL_API_SECRET=CHANGE_THIS_INTERNAL_SECRET
AUDIO_STORAGE_DIR=/data/audio-recordings
INSIGHTS_CACHE_TTL_SECONDS=300

# ══ Local development switches ══
# Keep both switches false in production. Recovery phrases are account secrets.
# Test tools expose time-acceleration controls for exercising participant flows.
ENABLE_TEST_TOOLS=false
EXPOSE_RECOVERY_PHRASES=false

# ══ Admin portal ══
# NEXTAUTH_SECRET signs portal sessions (generate with openssl rand -hex 32).
# Tool links are for the operator; exposing a link does not grant tool access.
# NEXT_PUBLIC_* values are baked into the frontend build; rebuild after changes.
# Compose supplies environment-specific URLs where explicitly configured.
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET
# NEXT_PUBLIC_GRAFANA_URL=http://grafana.localhost
NEXT_PUBLIC_POSTHOG_URL=http://172.26.52.166:8000
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_NEO4J_BROWSER_URL=http://localhost:7474
NEXT_PUBLIC_MONGO_EXPRESS_URL=http://localhost:8081
NEXT_PUBLIC_LIGHTRAG_WEBUI_URL=http://localhost:9622
NEXT_PUBLIC_REDIS_INSIGHT_URL=http://localhost:5540
# NEXT_PUBLIC_API_DOCS_URL=  # defaults to <api-host>/api-docs

# ══ Keycloak and authentication ══
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD administer the master realm.
# The local portal admin uses HHH_ADMIN_USER with KEYCLOAK_ADMIN_PASSWORD.
# Keep each confidential client's secret matched to its Keycloak client.
# hhh-flutter uses PKCE; only the server-side hhh-ropc client uses password grants.
# KC_DB_* is for production Keycloak PostgreSQL; local Keycloak uses embedded storage.
KEYCLOAK_ADMIN=admin                                    # Keycloak master-realm admin username
KEYCLOAK_ADMIN_PASSWORD=CHANGE_THIS_KEYCLOAK_PASSWORD  # Keycloak master-realm admin password
KC_DB_USERNAME=keycloak                                 # PostgreSQL user for Keycloak DB
KC_DB_PASSWORD=CHANGE_THIS_KC_DB_PASSWORD              # PostgreSQL password for Keycloak DB
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=hhh
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/hhh/protocol/openid-connect/certs
KEYCLOAK_JWT_ISSUER=http://keycloak:8080/realms/hhh
KEYCLOAK_JWT_AUDIENCE=account
KEYCLOAK_CLIENT_ID=hhh-flutter
KEYCLOAK_ADMIN_CLIENT_ID=hhh-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_BACKEND_SECRET
KEYCLOAK_ADMIN_UI_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_ADMIN_UI_SECRET
KEYCLOAK_ROPC_CLIENT_ID=hhh-ropc
KEYCLOAK_ROPC_CLIENT_SECRET=CHANGE_THIS_KEYCLOAK_ROPC_SECRET

# ══ Databases and cache ══
# MongoDB localhost defaults support host-run scripts; Compose sets the internal host.
# Neo4j is the graph database. Keep REDIS_PASSWORD before REDIS_URL so interpolation works.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_THIS_MONGO_PASSWORD
MONGO_DB=surveyjs
MONGO_AUTH_SOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=5000
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_NEO4J_PASSWORD
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ══ AI models and speech input ══
# Shared OpenAI-compatible provider credentials; model names are provider aliases.
# LLM_FALLBACK_MODEL must differ from the primary model. The cooldown controls
# recommender retries; the health interval controls LightRAG model re-probes.
# Recommendation overrides fall back to LLM_MODEL when absent.
# Context limit is in characters; completion limit is in tokens (0 = uncapped/default).
# Speech-to-text reuses LLM_API_KEY / LLM_API_BASE.
# LLM_API_BASE=                            # Optional: OpenAI-compatible base URL (e.g. https://llm.scads.ai/v1)
LLM_API_KEY=CHANGE_THIS_API_KEY            # Required for habit classification, context extraction, recommendations
LLM_MODEL=alias-ha                         # e.g. alias-ha, alias-huge, alias-reasoning — a SCADS.AI model alias, not a real OpenAI model name (gpt-4o-mini etc. are not served by llm.scads.ai)
LLM_TEMPERATURE=0.2                        # 0.0 = deterministic, 1.0 = creative
LLM_FALLBACK_MODEL=alias-reasoning
LLM_FALLBACK_COOLDOWN_S=300                # API-service: seconds a failed model is skipped before being retried
LLM_HEALTH_CHECK_INTERVAL_S=120            # lightrag container: seconds between primary-model health re-probes
# LLM_RECOMMEND_MODEL=
# RECOMMEND_MAX_CONTEXT_CHARS=30000
# LLM_RECOMMEND_MAX_TOKENS=0
# LIGHTRAG_LLM_MODEL=                      # Model the lightrag container itself uses (falls back to LLM_MODEL if unset)
LLM_STT_MODEL=alias-stt                    # Speech-to-text alias for habit-donation voice input (openai/whisper-large-v3-turbo on SCADS.AI) — reuses LLM_API_KEY/LLM_API_BASE, no separate credential

# ══ Embeddings and ontology mapping ══
# Embedding credentials fall back to the shared LLM provider when unset.
# Model, vector dimension and provider must agree. Chunk size is concepts per batch.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B    # Embedding model served at EMBEDDING_API_BASE
# EMBEDDING_DIM=                           # Optional: embedding vector size, if the model needs it declared explicitly
EMBEDDING_API_BASE=https://llm.scads.ai/v1 # Falls back to LLM_API_BASE if unset
EMBEDDING_API_KEY=CHANGE_THIS_API_KEY      # Falls back to LLM_API_KEY if unset
EMBEDDING_CHUNK_SIZE=200                   # Concepts per embedding batch (tune for provider limits)
BCIO_MIN_CONFIDENCE=0.6                    # Minimum cosine similarity to store a BCIO mapping (0.0-1.0)

# ══ LightRAG knowledge base ══
# LIGHTRAG_URL is the service address; LIGHTRAG_HOST_PORT is local-only.
# The API key is for internal callers. The WebUI has its own admin login.
# Generate TOKEN_SECRET with openssl rand -hex 32; keep it stable across restarts.
LIGHTRAG_URL=http://lightrag:9621          # URL used by API-service and knowledge-mcp to reach LightRAG
LIGHTRAG_API_KEY=dev-lightrag-secret       # Bearer token for LightRAG REST API auth (change in production)
LIGHTRAG_HOST_PORT=9622                    # Host port for LightRAG graph visualization UI
LIGHTRAG_AUTH_PASSWORD=CHANGE_THIS_LIGHTRAG_PASSWORD
LIGHTRAG_TOKEN_SECRET=CHANGE_THIS_LIGHTRAG_TOKEN_SECRET

# ══ Translation ══
# TRANSLATE_* configures backend calls. LIBRE_TRANSLATE_URL overrides the full URL.
# LT_* is read by the external LibreTranslate image, not by the application.
# Keep these aliases: they are still active even without references in our code.
# LT_LOAD_ONLY selects language packs; optional update/metrics flags stay commented.
TRANSLATE_HOST=translate
TRANSLATE_PORT=5000
TRANSLATE_PATH=/translate
# LIBRE_TRANSLATE_URL=http://translate:5000/translate
LT_HOST=${TRANSLATE_HOST}
LT_PORT=${TRANSLATE_PORT}
LT_LOAD_ONLY=de,en,ja,fr,nl    # Comma-separated ISO 639-1 codes; controls which language packs are loaded
LT_REQ_LIMIT=0                 # Max characters per request (0 = unlimited)
LT_DEBUG=
LT_DISABLE_WEB_UI=
# LT_UPDATE_MODELS=            # Uncomment to force model update on startup
# LT_METRICS=                  # Uncomment to enable Prometheus metrics

# ══ Push notifications ══
# Server Firebase service-account JSON must stay on one line. Empty = no-op push.
# Mobile app configuration lives in mobile/lib/firebase_options.dart; root-level
# mobile Firebase key variables are archived in the inactive section below.
FIREBASE_SERVICE_ACCOUNT_JSON=  # paste full service-account JSON string here

# ══ Email and alerts ══
# Generic SMTP relay for backup, API-service and Grafana alerts.
# Port 587 uses STARTTLS; port 465 uses implicit TLS (SMTP_STARTTLS=false).
# ALERT_EMAIL is the recipient; an optional webhook is used for backup alerts.
SMTP_HOST=CHANGE_THIS_SMTP_HOST        # e.g. smtp.your-provider.example
SMTP_PORT=587                          # 587 = STARTTLS (default), 465 = implicit TLS
SMTP_USER=CHANGE_THIS_SMTP_USER
SMTP_PASS=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM=noreply@example.com          # Accepts "Name <address>" form
SMTP_STARTTLS=true                     # Set false only if SMTP_PORT=465 (implicit TLS)
ALERT_EMAIL=admin@example.com  # BACKUP_EMAIL is a deprecated alias, still read as a fallback by backup-service/backup.sh
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ══ Backups ══
# BACKUP_API_SECRET protects the internal backup service and is required.
# Retention also caps scheduled-backup count; manual/uploaded backups are unaffected.
# OFFSITE_REMOTE is optional (empty = no offsite sync) and needs a separately
# configured backup-service/rclone/rclone.conf containing the remote credentials.
BACKUP_RETENTION_DAYS=14       # How many days of backups to retain; also caps daily automatic (scheduled) backups by count (manual/uploaded backups are unaffected by the count cap)
BACKUP_API_SECRET=CHANGE_THIS_BACKUP_API_SECRET
BACKUP_UPLOAD_MAX_MB=2048      # Max size for a backup archive uploaded via the admin UI
OFFSITE_REMOTE=

# ══ Operator monitoring and tool access ══
# Still used: these services are restricted to the platform operator.
# Grafana accepts only the admin realm role. Other internal dashboards use
# oauth2-proxy's admin-only SSO gate; LightRAG uses its separate login above.
# OAuth client secrets must match Keycloak. Cookie secret: openssl rand -base64 24
# (32 characters; do not use the 44-character rand -base64 32 output).
# METRICS_PORT is an optional backend scraping-port override.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_CLIENT_SECRET=CHANGE_THIS_GRAFANA_CLIENT_SECRET
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_THIS_OAUTH2_PROXY_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_THIS_32_CHAR_RANDOM_STRING
# METRICS_PORT=9091                            # Internal port for Prometheus scraping

# ══ Optional integrations — disabled until configured ══
# These features are supported, not retired. Empty URLs/keys leave them disabled.
# PostHog runs on the separate analytics VM, not inside the main application stack.
# Keep all related analytics settings together when enabling it.
# Use a self-hosted Sentry instance for SENTRY_DSN; sample rate 0 disables tracing.
POSTHOG_INTERNAL_URL=                           # e.g. http://10.0.0.42:8000
POSTHOG_SERVER_HOST=                            # normally same private URL; blank disables backend events
POSTHOG_PROJECT_KEY=                            # phc_... write-only project key; blank disables backend events
ANALYTICS_VM_HOST=                              # IP/DNS only, e.g. 10.0.0.42
ANALYTICS_VM_POSTHOG_PORT=8000                  # private PostHog HTTP port
POSTHOG_INGEST_RATE_AVERAGE=100                 # requests/second sustained
POSTHOG_INGEST_RATE_BURST=200
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ══ Optional verified-identity register ══
# Only needed for verified-identity studies and the Compose identity profile.
# Anonymous studies do not need this service. Templates below do not enable a profile.
# The master encryption key is a FILE, never an environment variable:
#   openssl rand -base64 32 > <data-directory>/identity-master-key
#   chmod 0400 <data-directory>/identity-master-key
# Keep a secure backup of that key; losing it makes identity records unrecoverable.
# KEK and blind-index versions rotate independently. Use separate SMTP credentials
# for identity invitations. BACKUP_INCLUDE_IDENTITY controls register backups;
# IDENTITY_DPO_ALERT_EMAIL receives every re-identification alert.
# See identity-service/README.md for setup and operational requirements.
IDENTITY_DB_USERNAME=identity
IDENTITY_DB_PASSWORD=CHANGE_THIS_IDENTITY_DB_PASSWORD
IDENTITY_SERVICE_SECRET=CHANGE_THIS_IDENTITY_SERVICE_SECRET
IDENTITY_SERVICE_URL=http://identity-service:3003
IDENTITY_KEK_VERSION=1
IDENTITY_BI_VERSION=1
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_USER=
IDENTITY_SMTP_PASS=
IDENTITY_SMTP_FROM=
BACKUP_INCLUDE_IDENTITY=false
IDENTITY_DPO_ALERT_EMAIL=

# ══ Inactive / legacy — no longer used by this application ══
# Preserved as comments for reference. Do not re-enable for current deployments.
# GRAPH_BACKEND: the old Fuseki/Neo4j selector has no application reader;
# the current application uses Neo4j. Compose already defaults to neo4j.
# FIREBASE_*_API_KEY: the root variables are not read by Flutter or Compose;
# mobile Firebase configuration is in mobile/lib/firebase_options.dart.
# GRAPH_BACKEND=neo4j
# FIREBASE_ANDROID_API_KEY=CHANGE_THIS_FIREBASE_ANDROID_API_KEY
# FIREBASE_IOS_API_KEY=CHANGE_THIS_FIREBASE_IOS_API_KEY
