---
import Legal from '../../../components/Legal.astro';

export function getStaticPaths() {
  const MAP = {
    imprint:       { doc: 'imprint',       key: 'imprint',       title: 'Imprint' },
    privacy:       { doc: 'privacy',       key: 'privacy',       title: 'Privacy' },
    consent:       { doc: 'consent',       key: 'consent',       title: 'Consent' },
    accessibility: { doc: 'accessibility', key: 'accessibility', title: 'Accessibility', inject: true },
  };
  return Object.entries(MAP).map(([doc, cfg]) => ({ params: { doc }, props: cfg }));
}

const { doc, key, title, inject } = Astro.props as { doc: string; key: any; title: string; inject?: boolean };
---
<Legal lang="en" doc={doc} pageKey={key} title={title} injectTitle={!!inject} />
