---
import { useT, type Lang } from '../i18n/ui';
import { references as allRefs, pageRefNumber, type RefId } from '../data/references';
// `ids` is this page's reference order — also the number source for <Cite>
// on the same page, so footnotes start at 1 on every page.
const { lang, ids } = Astro.props as { lang: Lang; ids: RefId[] };
const t = useT(lang);
const shown = ids.map((id) => allRefs.find((r) => r.id === id)!).filter(Boolean);
---
<section class="refs">
  <div class="wrap">
    <h2 class="refs-title">{t('refs_title')}</h2>
    <ol class="refs-list">
      {shown.map((r) => (
        <li id={`ref-${r.id}`}>
          <span class="refs-num">{pageRefNumber(ids, r.id)}</span>
          <span class="refs-body">
            <span class="refs-text">{r.citation}</span>
            {r.own && <span class="refs-own">{t('refs_own')}</span>}
            <a class="refs-link" href={r.url} target="_blank" rel="noopener">
              {t('refs_link')}
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
            </a>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .refs{padding:56px 0 88px;border-top:1px solid var(--line)}
  .refs-title{font-size:19px}
  .refs-list{list-style:none;margin:24px 0 0;padding:0;display:flex;flex-direction:column;gap:16px}
  .refs-list li{display:flex;gap:12px;scroll-margin-top:100px}
  .refs-num{flex:0 0 auto;width:22px;height:22px;border-radius:7px;background:var(--surface-alt);
    color:var(--muted);font-size:12px;font-weight:600;display:grid;place-items:center;margin-top:1px}
  .refs-body{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;font-size:14px;line-height:1.6}
  .refs-text{color:var(--muted)}
  .refs-own{font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
    color:var(--green-dark);background:var(--green-tint);border-radius:100px;padding:2px 9px}
  .refs-link{display:inline-flex;align-items:center;gap:5px;color:var(--green-dark);font-weight:600;white-space:nowrap}
  .refs-link:hover{text-decoration:underline}
</style>
