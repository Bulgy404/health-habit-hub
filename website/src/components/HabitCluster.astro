---
import { useT, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

const STAGES = [
  { key: '1', pos: 'right',  icon: 'donate', color: '#2e8c00' },
  { key: '2', pos: 'bottom', icon: 'graph',  color: '#0284c7' },
  { key: '3', pos: 'left',   icon: 'model',  color: '#7c3aed' },
  { key: '4', pos: 'top',    icon: 'gift',   color: '#ea580c' },
] as const;

// hand-drawn to mirror Apple's SF Symbols line weight (not the licensed
// assets themselves): stroke="currentColor" stroke-width="1.6", round caps.
const ICONS: Record<string, string> = {
  // square.and.arrow.up
  donate: '<path d="M12 3.2v10.3"/><path d="M8 7.2 12 3.2l4 4"/><path d="M5 12.5v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/>',
  // point.3.connected.trianglepath.dotted
  graph:  '<circle cx="6" cy="7" r="2"/><circle cx="18" cy="7" r="2"/><circle cx="12" cy="17" r="2"/><path d="M7.7 8.3 10.5 15.3"/><path d="M16.3 8.3 13.5 15.3"/><path d="M8 7h8"/>',
  // gearshape
  model:  '<circle cx="12" cy="12" r="4.6"/><path d="M12 2.4v2.2"/><path d="M12 19.4v2.2"/><path d="M21.6 12h-2.2"/><path d="M4.6 12H2.4"/><path d="M18.79 5.21l-1.56 1.56"/><path d="M6.77 17.23l-1.56 1.56"/><path d="M18.79 18.79l-1.56-1.56"/><path d="M6.77 6.77 5.21 5.21"/>',
  // star (recommendation)
  gift:   '<path d="M12 3.6 14.1 9.3 20.3 9.4 15.3 13.2 17 19.4 12 15.8 7 19.4 8.7 13.2 3.7 9.4 9.9 9.3 12 3.6Z"/>',
};
---
<div class="loop-wrap reveal">
  <p class="loop-caption">{t('graph_loop_caption')}</p>
  <div class="loop-ring" data-loop>
    <svg class="loop-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <circle cx="50" cy="50" r="42" />
    </svg>
    {Array.from({ length: 7 }).map((_, i) => (
      <span class="packet" data-packet data-phase={(i / 7).toFixed(4)}></span>
    ))}
    {STAGES.map((s) => (
      <div class={`stage stage-${s.pos}`} style={`--sc:${s.color}`}>
        <span class="stage-ic" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${ICONS[s.icon]}</svg>`}></span>
        <strong>{t(`graph_loop_${s.key}_t`)}</strong>
      </div>
    ))}
  </div>
</div>

<div class="loop-cards">
  {STAGES.map((s, i) => (
    <div class="lc reveal" style={`--sc:${s.color}`}>
      <span class="lc-n">{i + 1}</span>
      <div><h3>{t(`graph_loop_${s.key}_t`)}</h3><p>{t(`graph_loop_${s.key}_p`)}</p></div>
    </div>
  ))}
</div>

<p class="pg-method">{t('graph_method')}</p>

<style>
  .loop-wrap{text-align:center}
  .loop-caption{color:var(--muted);font-size:15.5px;margin-bottom:36px}
  .loop-ring{position:relative;width:min(440px,92%);aspect-ratio:1/1;margin:0 auto}
  .loop-line{position:absolute;inset:0;width:100%;height:100%}
  .loop-line circle{fill:none;stroke:var(--line);stroke-width:1}

  .packet{position:absolute;top:0;left:0;width:8px;height:8px;margin:-4px 0 0 -4px;border-radius:50%;
    background:#2e8c00;box-shadow:0 0 9px rgba(46,140,0,.45);
    offset-path:circle(42% at 50% 50%);offset-distance:0%;offset-rotate:0deg;
    transition:background-color .5s linear}
  @media (prefers-reduced-motion: reduce){.packet{opacity:0}}

  .stage{position:absolute;display:flex;flex-direction:column;align-items:center;gap:9px;width:104px;transform:translate(-50%,-50%)}
  .stage-right{left:92%;top:50%}
  .stage-bottom{left:50%;top:92%}
  .stage-left{left:8%;top:50%}
  .stage-top{left:50%;top:8%}
  .stage-ic{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:var(--surface);border:1px solid var(--line);color:var(--sc, var(--green-dark));box-shadow:0 10px 24px -14px rgba(15,23,42,.3);transition:box-shadow .35s}
  .stage-ic svg{width:22px;height:22px}
  .stage strong{font-size:13.5px;font-weight:600}

  .loop-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:56px}
  .lc{display:flex;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px;text-align:left;transition:transform .3s var(--ease-out),box-shadow .3s,border-color .3s}
  .lc:hover{transform:translateY(-3px);border-color:var(--sc,var(--green));box-shadow:0 14px 34px -18px rgba(46,140,0,.3)}
  .lc-n{flex:0 0 auto;width:26px;height:26px;border-radius:8px;background:color-mix(in srgb, var(--sc, var(--green)) 14%, white);color:var(--sc, var(--green-dark));display:grid;place-items:center;font-family:'Fraunces Variable',serif;font-size:13px;font-weight:600}
  .lc h3{font-size:15.5px}
  .lc p{color:var(--muted);font-size:13px;margin-top:6px;line-height:1.55}

  .pg-method{margin-top:32px;font-size:13px;color:var(--muted);line-height:1.6;max-width:78ch}

  @media(max-width:820px){
    .loop-ring{width:min(320px,88%)}
    .stage{width:78px}
    .stage-ic{width:38px;height:38px}
    .stage strong{font-size:11.5px}
    .loop-cards{grid-template-columns:1fr 1fr}
  }
  @media(max-width:520px){.loop-cards{grid-template-columns:1fr}}
</style>

<script>
  // Slow, continuous packets orbiting the loop. Each packet's colour shifts
  // through the four stage colours as it passes right -> bottom -> left -> top,
  // matching the stage markers positioned around the ring.
  const ring = document.querySelector('[data-loop]') as HTMLElement | null;
  if (ring) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const packets = Array.from(ring.querySelectorAll('[data-packet]')) as HTMLElement[];
    const STAGE_COLORS = ['#2e8c00', '#0284c7', '#7c3aed', '#ea580c'];
    const CYCLE_MS = 22000; // slow, calm orbit

    function colorFor(p: number): string {
      const seg = p * 4;
      const i = Math.floor(seg) % 4;
      const j = (i + 1) % 4;
      const localT = seg - Math.floor(seg);
      return mix(STAGE_COLORS[i], STAGE_COLORS[j], localT);
    }
    function mix(a: string, b: string, t: number): string {
      const pa = hex(a), pb = hex(b);
      const r = Math.round(pa[0] + (pb[0] - pa[0]) * t);
      const g = Math.round(pa[1] + (pb[1] - pa[1]) * t);
      const bl = Math.round(pa[2] + (pb[2] - pa[2]) * t);
      return `rgb(${r},${g},${bl})`;
    }
    function hex(h: string): [number, number, number] {
      const v = parseInt(h.slice(1), 16);
      return [(v >> 16) & 255, (v >> 8) & 255, v & 255];
    }

    if (reduce || !packets.length) {
      // static: park each packet at its phase position with its stage colour
      packets.forEach((el) => {
        const phase = parseFloat(el.dataset.phase || '0');
        el.style.offsetDistance = (phase * 100) + '%';
        el.style.backgroundColor = colorFor(phase);
      });
    } else {
      let started = false;
      function frame(now: number) {
        const t0 = (now % CYCLE_MS) / CYCLE_MS;
        for (const el of packets) {
          const phase = parseFloat(el.dataset.phase || '0');
          const p = (t0 + phase) % 1;
          el.style.offsetDistance = (p * 100) + '%';
          el.style.backgroundColor = colorFor(p);
        }
        requestAnimationFrame(frame);
      }
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting && !started) { started = true; requestAnimationFrame(frame); io.disconnect(); }
      }), { threshold: .2 });
      io.observe(ring);
    }
  }
</script>
