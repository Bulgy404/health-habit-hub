---
import { useT, links, type Lang } from '../i18n/ui';
import { Image } from 'astro:assets';
import ContactForm from './ContactForm.astro';
import adminPortal from '../assets/mockups/adminPortal-v2.png';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const caps = [
  ['r_cap_1_t','r_cap_1_p'],['r_cap_2_t','r_cap_2_p'],['r_cap_3_t','r_cap_3_p'],
  ['r_cap_4_t','r_cap_4_p'],['r_cap_5_t','r_cap_5_p'],['r_cap_6_t','r_cap_6_p'],
];
// ordered as the researcher actually experiences it: set up the study,
// then a participant joins, signs in and consents, then data flows in
// TU Dresden is not one more step in the chain, it's the ground everything
// else runs on - so it gets its own frame around the six real steps instead
// of a seventh node in the line
const arch = [
  ['r_arch_setup','r_arch_setup_d','r_arch_setup_x'],
  ['r_arch_app','r_arch_app_d','r_arch_app_x'],
  ['r_arch_auth','r_arch_auth_d','r_arch_auth_x'],
  ['r_arch_api','r_arch_api_d','r_arch_api_x'],
  ['r_arch_data','r_arch_data_d','r_arch_data_x'],
  ['r_arch_rec','r_arch_rec_d','r_arch_rec_x'],
];
---
<div class="rtheme">
<header class="r-hero">
  <div class="wrap r-hero-in reveal">
    <span class="eyebrow">{t('nav_research')}</span>
    <h1>{t('r_hero_title')}</h1>
    <p class="lead">{t('r_hero_lead')}</p>
    <div class="r-cta">
      <a class="btn btn-primary btn-lg" href={links.admin}>{t('r_admin_btn')} &rarr;</a>
      <a class="btn btn-ghost btn-lg" href={links.github}>{t('r_docs_btn')}</a>
    </div>
  </div>
</header>

<section class="shot">
  <div class="wrap reveal">
    <div class="shot-frame"><Image src={adminPortal} alt={t('r_shot_cap')} widths={[640,960,1200]} sizes="(max-width:1160px) 92vw, 1104px" /></div>
    <p class="cap">{t('r_shot_cap')}</p>
  </div>
</section>

<section class="arch">
  <div class="wrap">
    <div class="reveal"><span class="eyebrow">{t('r_arch_eyebrow')}</span><h2 class="sec-title">{t('r_arch_title')}</h2><p class="sec-sub">{t('r_arch_p')}</p></div>

    <div class="tu-base reveal">
      <div class="tu-tag"><span class="tu-dot"></span>{t('r_arch_edge')} <em>{t('r_arch_edge_d')}</em></div>

      <div class="arch-scroll">
        <div class="arch-track" data-arch>
          <div class="arch-base" aria-hidden="true"></div>
          <div class="arch-line"><span class="pulse" data-arch-pulse></span></div>
          {arch.map(([k,d]) => (
            <div class="node"><span class="dot"></span><strong>{t(k)}</strong><small>{t(d)}</small></div>
          ))}
        </div>
      </div>
      <div class="arch-cards">
        {arch.map(([k,d,x], i) => (
          <div class="ac reveal"><span class="ac-n">{i+1}</span><div><h3>{t(k)} <em>{t(d)}</em></h3><p>{t(x)}</p></div></div>
        ))}
      </div>

      <p class="tu-note">{t('r_arch_edge_x')}</p>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="reveal"><span class="eyebrow">{t('r_cap_eyebrow')}</span><h2 class="sec-title">{t('r_cap_title')}</h2></div>
    <div class="cap-grid">
      {caps.map(([tt,pp]) => (<div class="cap-card reveal"><h3>{t(tt)}</h3><p>{t(pp)}</p></div>))}
    </div>
  </div>
</section>

<section id="kontakt" class="contact">
  <div class="wrap contact-in">
    <div class="contact-txt reveal">
      <span class="eyebrow">{t('r_contact_eyebrow')}</span>
      <h2>{t('r_contact_title')}</h2>
      <p>{t('r_contact_p')}</p>
    </div>
    <div class="contact-form reveal"><ContactForm lang={lang} /></div>
  </div>
</section>
</div>

<style>
  .r-hero{padding:88px 0 36px}
  .r-hero h1{font-size:clamp(34px,4.8vw,56px);margin:14px 0 0;max-width:20ch}
  .r-hero .lead{font-size:clamp(17px,1.9vw,20px);color:var(--muted);margin:22px 0 30px;max-width:90ch;line-height:1.65}
  .r-cta{display:flex;gap:14px;flex-wrap:wrap;align-items:stretch}
  .r-cta .btn{display:inline-flex;align-items:center}
  .shot{padding:20px 0 40px}
  .shot-frame{border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 40px 80px -40px rgba(15,23,42,.34);background:var(--surface)}
  .shot-frame :global(img){width:100%;height:auto;display:block}
  .shot .cap{color:var(--muted);font-size:14.5px;margin-top:16px;max-width:78ch;line-height:1.6}

  .arch{background:var(--surface-alt);padding:80px 0}
  /* TU Dresden as the base everything else stands on, not a 7th step */
  .tu-base{position:relative;margin-top:44px;border:2px solid rgba(234,88,12,.28);border-radius:26px;
    padding:40px 26px 28px;background:linear-gradient(180deg,var(--orange-tint),transparent 30%)}
  .tu-tag{position:absolute;top:-15px;left:28px;display:inline-flex;align-items:center;gap:8px;
    background:var(--slate);color:#fff;font-size:12.5px;font-weight:600;padding:7px 14px 7px 11px;
    border-radius:100px;box-shadow:0 8px 18px -8px rgba(15,23,42,.4)}
  .tu-tag em{font-style:normal;font-weight:500;color:#cbd5e1;margin-left:2px}
  .tu-dot{width:7px;height:7px;border-radius:50%;background:var(--orange-soft);box-shadow:0 0 0 3px rgba(251,146,60,.28)}
  .tu-note{margin-top:26px;font-size:13px;color:var(--muted);line-height:1.6;max-width:78ch}

  .arch-scroll{overflow:visible;padding:24px 4px 18px}
  .arch-track{position:relative;display:flex;align-items:flex-start}
  .arch-base{position:absolute;inset:-8px -3% -14px;border-radius:16px;
    background:rgba(234,88,12,.05);border:1px dashed rgba(234,88,12,.22)}
  .arch-line{position:absolute;left:6%;right:6%;top:9px;height:2px;background:linear-gradient(90deg,var(--green-soft),var(--green-dark));border-radius:2px}
  .arch-line .pulse{position:absolute;top:50%;left:0;width:12px;height:12px;border-radius:50%;background:var(--green-action);transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(249,115,22,.18)}
  .node{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 8px}
  .node .dot{width:20px;height:20px;border-radius:50%;background:var(--surface);border:2px solid var(--green-action);position:relative;z-index:2;transition:transform .3s var(--ease-out),box-shadow .3s}
  .node.hot .dot{transform:scale(1.25);box-shadow:0 0 0 6px rgba(249,115,22,.16)}
  .node strong{font-size:14.5px;margin-top:14px;font-weight:600}
  .node small{font-size:12.5px;color:var(--muted);margin-top:3px}
  .arch-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}
  .ac{display:flex;gap:16px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px;transition:transform .3s var(--ease-out),box-shadow .3s,border-color .3s}
  .ac:hover{transform:translateY(-3px);border-color:var(--green);box-shadow:0 14px 34px rgba(234,88,12,.1)}
  .ac-n{flex:0 0 auto;width:30px;height:30px;border-radius:9px;background:var(--green-tint);color:var(--green-dark);display:grid;place-items:center;font-family:'Fraunces Variable',serif;font-size:15px;font-weight:600}
  .ac h3{font-size:16.5px}
  .ac h3 em{font-style:normal;color:var(--green-dark);font-weight:500;font-family:'Figtree Variable',sans-serif;font-size:13px;display:block;margin-top:2px}
  .ac p{color:var(--muted);font-size:14px;margin-top:8px;line-height:1.6}

  .cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
  .cap-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:26px;transition:transform .3s var(--ease-out),box-shadow .3s,border-color .3s}
  .cap-card:hover{border-color:var(--green);box-shadow:0 14px 34px rgba(234,88,12,.1);transform:translateY(-3px)}
  .cap-card h3{font-size:18px}
  .cap-card p{color:var(--muted);font-size:14.5px;margin-top:8px;line-height:1.6}

  .contact{background:var(--slate);color:#e2e8f0;padding:84px 0}
  .contact-in{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:start}
  .contact .eyebrow{color:var(--orange-soft)}
  .contact-txt h2{color:#fff;font-size:clamp(26px,3.2vw,38px);margin-top:12px}
  .contact-txt p{color:#94a3b8;margin-top:14px;font-size:16px;line-height:1.65;max-width:38ch}
  .contact-form :global(.cform label){color:#fff}
  .contact-form :global(.cform input),.contact-form :global(.cform textarea){background:#1a2536;border-color:#334155;color:#fff}
  .contact-form :global(.cform input:focus),.contact-form :global(.cform textarea:focus){border-color:var(--orange);box-shadow:0 0 0 4px rgba(249,115,22,.14)}
  .contact-form :global(.cf-hint){color:#94a3b8}
  @media(max-width:900px){.arch-cards,.cap-grid{grid-template-columns:1fr}.contact-in{grid-template-columns:1fr;gap:32px}}

  /* pipeline stacks vertically on narrow screens instead of squeezing sideways */
  @media(max-width:680px){
    .tu-base{padding:36px 18px 24px}
    .arch-base{display:none}
    .arch-line{display:none}
    .arch-track{flex-direction:column;align-items:stretch;gap:0;padding-left:10px}
    .node{position:relative;flex:none;flex-direction:row;align-items:flex-start;text-align:left;gap:14px;padding:0 0 26px}
    .node::before{content:"";position:absolute;left:9px;top:24px;bottom:-2px;width:2px;
      background:linear-gradient(180deg,var(--green-soft),var(--green-dark));border-radius:2px}
    .node:last-child::before{display:none}
    .node:last-child{padding-bottom:0}
    .node .dot{flex:0 0 auto;margin-top:1px}
    .node strong{margin-top:0}
    .node strong,.node small{display:block}
  }
</style>

<script>
  const track = document.querySelector('[data-arch]') as HTMLElement | null;
  const pulse = document.querySelector('[data-arch-pulse]') as HTMLElement | null;
  if (track && pulse){
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nodes = Array.from(track.querySelectorAll('.node')) as HTMLElement[];
    if (reduce){ pulse.style.display='none'; }
    else {
      let started = false;
      const io = new IntersectionObserver((es)=>es.forEach(e=>{ if(e.isIntersecting && !started){ started=true; run(); }}),{threshold:.4});
      io.observe(track);
      function run(){
        const dur = 10000, t0 = performance.now();
        function frame(t:number){
          const p = ((t - t0) % dur) / dur;
          pulse.style.left = (p*100)+'%';
          const active = Math.round(p*(nodes.length-1));
          nodes.forEach((n,i)=> n.classList.toggle('hot', i===active));
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
    }
  }
</script>
