---
import { useT, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<form class="cform" data-cform novalidate>
  <div class="row">
    <label>{t('cf_name')}<input name="name" type="text" required autocomplete="name" /></label>
    <label>{t('cf_email')}<input name="email" type="email" required autocomplete="email" /></label>
  </div>
  <label>{t('cf_org')}<input name="org" type="text" autocomplete="organization" /></label>
  <label>{t('cf_msg')}<textarea name="msg" rows="5" required placeholder={t('cf_msg_ph')}></textarea></label>
  <!-- honeypot: hidden from real visitors, bots tend to fill every field -->
  <label class="hp" aria-hidden="true"><input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
  <button class="btn btn-primary btn-lg" type="submit" data-cform-btn data-sending={t('cf_sending')} data-success={t('cf_success')} data-error={t('cf_error')}>{t('cf_send')} &rarr;</button>
  <p class="cf-status" data-cform-status role="status" aria-live="polite"></p>
</form>

<style>
  .cform{display:flex;flex-direction:column;gap:16px}
  .cform .row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .cform label{display:flex;flex-direction:column;gap:7px;font-size:13.5px;font-weight:600;color:var(--ink)}
  .cform input,.cform textarea{font-family:inherit;font-size:15px;font-weight:400;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:11px;padding:12px 14px;transition:border-color .16s var(--ease-out),box-shadow .16s var(--ease-out)}
  .cform input:focus,.cform textarea:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(69,183,0,.12)}
  .cform textarea{resize:vertical;min-height:120px}
  .cform button{align-self:flex-start;margin-top:2px;transition:opacity .2s}
  .cform button[disabled]{opacity:.6;cursor:default}
  .cform .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .cf-status{font-size:13px;min-height:1.4em}
  .cf-status[data-state="error"]{color:#fca5a5}
  .cf-status[data-state="success"]{color:var(--green-soft)}
  .cf-status[data-state="sending"]{color:var(--muted)}
  @media(max-width:560px){.cform .row{grid-template-columns:1fr}}
</style>

<script>
  const f = document.querySelector('[data-cform]') as HTMLFormElement | null;
  const btn = document.querySelector('[data-cform-btn]') as HTMLButtonElement | null;
  const status = document.querySelector('[data-cform-status]') as HTMLElement | null;
  if (f && btn && status) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const g = (n: string) => (f.elements.namedItem(n) as HTMLInputElement)?.value?.trim() || '';
      const payload = { name: g('name'), email: g('email'), org: g('org'), msg: g('msg'), website: g('website') };

      btn.disabled = true;
      status.dataset.state = 'sending';
      status.textContent = btn.dataset.sending || '';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          status.dataset.state = 'success';
          status.textContent = btn.dataset.success || '';
          f.reset();
        } else {
          throw new Error(data.error || 'send_failed');
        }
      } catch {
        status.dataset.state = 'error';
        status.textContent = btn.dataset.error || '';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
