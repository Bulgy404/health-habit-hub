---
import { links, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };

// Apple's own badge-generator artwork + tracked link (itscg/itsct/mttnsubad
// are Apple's attribution params for this specific badge placement) — use
// verbatim rather than swapping in the plain links.appStore short link, so
// App Store Connect can attribute installs back to this badge.
const appleBadge = {
  de: { locale: 'de-de', alt: 'Laden im App Store' },
  en: { locale: 'en-us', alt: 'Download on the App Store' },
}[lang];
const appleHref =
  'https://apps.apple.com/us/app/health-habit-hub/id6793165538?itscg=30200&itsct=apps_box_badge&mttnsubad=6793165538';

// Google's official localized badge artwork (play.google.com/intl/*/badges),
// vendored as SVG from github.com/pioug/google-play-badges into public/badges/.
// The alt texts are Google's own badge wording for each locale.
const playBadge = {
  de: { src: '/badges/google-play-de.svg', alt: 'Jetzt bei Google Play' },
  en: { src: '/badges/google-play-en.svg', alt: 'Get it on Google Play' },
}[lang];
---
<div class="badges">
  <a class="badge ios" href={appleHref} target="_blank" rel="noopener">
    <img
      src={`https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-app-store/black/${appleBadge.locale}?releaseDate=1785974400`}
      alt={appleBadge.alt}
      width="246"
      height="82"
    />
  </a>
  <a class="badge android" href={links.playStore} target="_blank" rel="noopener">
    <img src={playBadge.src} alt={playBadge.alt} width="239" height="71" />
  </a>
</div>
<style>
  .badges{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  /* Same height for both store badges (the width follows each artwork); shrinks on phones so they stay on one row */
  .badge{display:inline-flex;align-items:center;height:clamp(36px,calc((100vw - 66px) / 6.4),54px);transition:transform .14s,box-shadow .2s}
  .badge img{height:100%;width:auto}
  .badge:active{transform:scale(.97)}
</style>
