{
  // Static Astro site — no adapter, no Worker code. Wrangler just uploads
  // ./dist (the astro build output) as static assets served from the edge.
  "name": "health-habit-hub-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
