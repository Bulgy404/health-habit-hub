{
  "realm": "hhh",
  "enabled": true,
  "displayName": "Health-Habit-Hub",
  "displayNameHtml": "<b>Health-Habit-Hub</b>",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "permanentLockout": false,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined)",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "offlineSessionIdleTimeout": 15552000,
  "offlineSessionMaxLifespanEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "App user role — habit donation via mobile app",
        "composite": false,
        "clientRole": false,
        "containerId": "hhh"
      },
      {
        "name": "admin",
        "description": "Administrator role",
        "composite": false,
        "clientRole": false,
        "containerId": "hhh"
      },
      {
        "name": "researcher",
        "description": "Researcher role",
        "composite": false,
        "clientRole": false,
        "containerId": "hhh"
      }
    ]
  },
  "clients": [
    {
      "clientId": "hhh-flutter",
      "name": "HHH Flutter App",
      "description": "Public PKCE client for the Flutter mobile/web application",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "de.tu-dresden.hhh://*",
        "hhh://*",
        "http://localhost:*"
      ],
      "webOrigins": ["http://localhost:*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "openid",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "hhh-ropc",
      "name": "HHH Server-side ROPC",
      "description": "Confidential server-side client used by the Express backend to mint token pairs for participants (onboarding, credential rotation, passphrase restore) via the OAuth password grant. Never exposed to the mobile app — hhh-flutter has direct grants disabled.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_THIS_KEYCLOAK_ROPC_SECRET",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "openid",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "hhh-backend",
      "name": "HHH Backend Service",
      "description": "Confidential client for the Express backend service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "CHANGE_THIS_KEYCLOAK_BACKEND_SECRET",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "openid",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "hhh-admin",
      "name": "HHH Admin Panel",
      "description": "Confidential OIDC client for the Next.js admin web application",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "hhh-admin-secret-change-me",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3001/*",
        "http://admin.localhost/*",
        "https://${DOMAIN}/admin/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://admin.localhost",
        "https://${DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "openid",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "description": "Confidential OIDC client for Grafana SSO via Keycloak",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "grafana-secret-change-me",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/login/generic_oauth",
        "http://grafana.localhost/login/generic_oauth",
        "http://localhost:3002/login/generic_oauth",
        "https://${DOMAIN}/grafana/login/generic_oauth"
      ],
      "webOrigins": ["http://grafana.localhost", "https://${DOMAIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "openid",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "oauth2-proxy",
      "name": "oauth2-proxy",
      "description": "Confidential OIDC client for oauth2-proxy — SSO gate in front of the internal tools (Prometheus, Bull Board, RedisInsight, Neo4j Browser, mongo-express). Access is restricted to the realm 'admin' role by oauth2-proxy's --allowed-role.",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "oauth2-proxy-secret-change-me",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost/oauth2/callback",
        "https://${DOMAIN}/oauth2/callback"
      ],
      "webOrigins": ["https://${DOMAIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "openid",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "defaultRoles": ["offline_access", "uma_authorization"],
  "users": []
}
