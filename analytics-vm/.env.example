# Copy this file to .env on the analytics VM and replace every CHANGE_ME value.

# Immutable PostHog source revision verified on 2026-09-05. Updating PostHog is
# an explicit change: test a new revision, then replace this value.
POSTHOG_UPSTREAM_REVISION=594d496a53acd051733ae564542fe43f1e54eda2
# Multi-platform image-index digests resolved from the registries on the same
# date. Keep the readable tag plus digest so the source/image relationship is
# visible while the pulled content stays immutable.
POSTHOG_APP_TAG=594d496a53acd051733ae564542fe43f1e54eda2@sha256:09679866fc1f3c8e8bb11f1ab0a5be41c9ee6c1afcfbb13984c88c42fe486f88
POSTHOG_NODE_TAG=latest@sha256:863e76e040ad41aef79f605c33ec71f1529bddf94cfd88941c935da9bde97235
REGISTRY_URL=posthog/posthog

# Bind only to the VM's private TU-network address. The management script
# refuses 0.0.0.0 and :: because the PostHog admin UI must not be public.
POSTHOG_BIND_ADDRESS=CHANGE_ME_PRIVATE_IP
POSTHOG_HTTP_PORT=8000
POSTHOG_SITE_URL=http://CHANGE_ME_PRIVATE_IP:8000

# These values are generated once and must then remain stable. Commands:
#   openssl rand -hex 32
#   openssl rand -hex 16
POSTHOG_SECRET=CHANGE_ME_64_HEX
ENCRYPTION_SALT_KEYS=CHANGE_ME_32_HEX
BROWSERLESS_SECRET=CHANGE_ME_64_HEX
INTERNAL_API_SECRET=CHANGE_ME_64_HEX

# Upstream expects DOMAIN even though our private-only Caddy override listens
# on :80. Use a private DNS name when available, otherwise the private IP.
DOMAIN=CHANGE_ME_PRIVATE_DNS_OR_IP
TLS_BLOCK=
CADDY_TLS_BLOCK=

# Docker must use the large data disk before the first image is pulled.
ANALYTICS_DOCKER_ROOT=/data/docker

# Local staging area for PostgreSQL and ClickHouse backup archives. Keep this
# outside Docker's data-root. OFFSITE_REMOTE uses an administrator-configured
# host rclone remote; blank keeps backups local and is reported in the manifest.
ANALYTICS_BACKUP_DIR=/data/posthog-backups
ANALYTICS_BACKUP_RETENTION_DAYS=14
OFFSITE_REMOTE=

# Stable Compose project name keeps container names and monitoring queries
# predictable across upgrades.
COMPOSE_PROJECT_NAME=hhh-analytics

# Optional. Leave blank to keep PostHog AI features disabled.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
